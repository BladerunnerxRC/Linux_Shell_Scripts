#!/bin/bash
# safe-power — Safe reboot / shutdown for the optiplex cluster
#
# Usage (re-runs itself with sudo if not root):
#   safe-power --reboot   [NODE]   drain + reboot, then restore on boot
#   safe-power --shutdown [NODE]   drain + power off (restore at next power-on)
#   safe-power --drain    [NODE]   drain only, no power action
#   safe-power --restore  [NODE]   bring a drained node back (auto on boot)
#   safe-power --status   [NODE]   drained / ok / failed
#   safe-power --check    [NODE]   verify service account, SSH trust, kubectl
#   safe-power --needs-reboot [NODE|--all]   does a node need a reboot?
#   safe-power --cancel            cancel runs scheduled with --at
#
#   safe-power --reboot   --all    rolling reboot: other workers → control
#                                  plane → this node last; one at a time,
#                                  stops if a node doesn't come back healthy
#                                  or the time limit (--max-time) is reached
#   safe-power --shutdown --all    cluster power-off (UPS): workers in
#                                  parallel → control plane → this node
#   safe-power --status   --all    status of every node
#   safe-power --check    --all    run checks on every node
#   add --workers-only to any --all command to leave the control plane alone
#
#   NODE defaults to this host. Any node can target any other node; the work
#   runs on NODE itself over SSH as the safepower service account.
#
#   Options: -y/--yes (no prompt), -n/--dry-run, --no-wait (don't wait for a
#            remote reboot to finish restoring), --wait-backups (wait up to
#            1h for running backups), --ignore-backups, --max-time=MINUTES
#            (--all time limit, default 240), --allow-concurrent (skip the
#            one-node-down lock), -h/--help
#            --if-needed   with --reboot: only nodes that need it (pending
#                          updates or a newer kernel)
#            --at WHEN     run later: 03:00, "tomorrow 02:30", "2026-10-03 04:00"
#
#   Log: /var/log/safe-power.log on the node doing the work.  man safe-power
#
# Role is picked from the hostname:
#   Control plane — kubectl drain self, drain Swarm node, stop Docker
#                   containers; on boot: uncordon, restart, health-check
#   Worker        — kubectl drain self; on boot: wait for Ready, uncordon
#
# One-time setup of the service account on all nodes: safe-power-setup

set -uo pipefail

# ------------------------------------------------------------ CONFIGURATION
# Defaults; /etc/safe-power/cluster.conf (written by safe-power-setup) overrides.
CONTROL_PLANE_HOST="optiplex-docker"
NODES=()
SVC_USER="safepower"
NODE_NAME="$(hostname -s)"
DRAIN_ARGS=(--ignore-daemonsets --delete-emptydir-data)
HEALTH_URLS=(                                 # checked on the control plane only
  "http://localhost:7171"   # comixed
  "http://localhost:3000"   # grafana
  "http://localhost:8080"   # jira
)
# --- Backup detection (preflight). Regexes are extended (ERE), case-sensitive.
BACKUP_PROCS="restic|borg|borgmatic|kopia|duplicity|rsnapshot|rdiff-backup|vzdump|veeamagent|pg_dump|pg_dumpall|mysqldump|mariadb-dump|mongodump|xtrabackup|mariabackup"
BACKUP_CMDLINE="docker_backup|backup\.sh"     # scripts, matched against the full command line
BACKUP_IGNORE=" (server|mount|serve-http)( |$)"   # long-running daemons that aren't a backup in progress
BACKUP_UNITS="backup|borg|restic|rsnapshot|kopia|duplicati|veeam"   # systemd services still running
BLOCKING_CONTAINERS=("backup-job")            # one-shot containers: running at all = backup in progress
BACKUP_WAIT=0             # seconds to wait for backups to finish; 0 = abort (--wait-backups: 3600)

# --- Docker shutdown order. Tier 1 apps → tier 2 data → tier 3 infrastructure.
# Override per container with label safe-power.tier=1|2|3, or safe-power.skip=true.
DB_IMAGES="postgres|postgis|timescale|mysql|mariadb|mongo|redis|valkey|keydb|influxdb|elasticsearch|opensearch|clickhouse|cassandra|couchdb|etcd|rabbitmq|mosquitto|emqx|nats|kafka|zookeeper|minio"
INFRA_IMAGES="traefik|nginx-proxy|caddy|haproxy|pihole|adguard|unbound|bind9|coredns|portainer|wireguard|tailscale|cloudflared|authelia|authentik"
IMAGE_SUFFIXES="db|ql|sql|server|ce|ee|oss|home|manager|stack|alpine"   # postgresql, portainer-ce, adguardhome …
STOP_TIMEOUT=60           # seconds for apps (tier 1) and infrastructure (tier 3)
DB_STOP_TIMEOUT=120       # seconds for databases / brokers (tier 2)
HEALTH_WAIT=120           # restore: seconds to wait for a tier's healthchecks before the next
DRAIN_TIMEOUT=300         # seconds for kubectl drain / swarm tasks to leave
CONVERGE_TIMEOUT=600      # seconds to wait after boot for Ready/services/health
ROLL_PAUSE=60             # --all: seconds to let workloads settle between nodes
ROLL_MAX=14400            # --all: don't start another node after this many seconds (0 = no limit)
ONE_AT_A_TIME=1           # refuse to drain while another Kubernetes node is cordoned / NotReady

# --- Mounts that must be up after boot, e.g. ("/mnt/nas_backups" "/mnt/restic-backups").
# Checked on restore BEFORE containers start, so nothing writes into an empty mount point.
REQUIRED_MOUNTS=()
MOUNT_WAIT=120            # seconds to wait for each required mount after boot

# --- --if-needed: what counts as "this node needs a reboot"
REBOOT_REQUIRED_FILE="/var/run/reboot-required"   # Debian / Ubuntu
BOOT_DIR="/boot"                                  # newest vmlinuz-* vs the running kernel

# --- Notifications (blank = off). Set cluster-wide with safe-power-setup --ntfy / --ha-webhook.
NOTIFY_NTFY_URL=""        # e.g. https://ntfy.sh/my-cluster  or  http://ntfy.lan/safe-power
NOTIFY_NTFY_TOKEN=""      # ntfy access token, if the topic needs one (put it in local.conf)
NOTIFY_HA_WEBHOOK=""      # e.g. http://homeassistant.lan:8123/api/webhook/safe-power
CONF_DIR="/etc/safe-power"
STATE_DIR="/var/lib/safe-power"
LOG_FILE="/var/log/safe-power.log"
UNIT_NAME="safe-power-restore.service"
UNIT_FILE="/etc/systemd/system/${UNIT_NAME}"
SCRIPT_PATH="$(readlink -f "$0")"

# cluster.conf is rewritten by safe-power-setup; put per-node overrides in local.conf
# shellcheck source=/dev/null
[ -r "$CONF_DIR/cluster.conf" ] && . "$CONF_DIR/cluster.conf"
# shellcheck source=/dev/null
[ -r "$CONF_DIR/local.conf" ] && . "$CONF_DIR/local.conf"

SVC_KUBECONFIG="$CONF_DIR/kubeconfig"
SVC_HOME="$(getent passwd "$SVC_USER" | cut -d: -f6)"
if [ "$NODE_NAME" = "$CONTROL_PLANE_HOST" ]; then ROLE="control-plane"; else ROLE="worker"; fi

KUBECTL=()
if command -v kubectl >/dev/null; then KUBECTL=(kubectl)
elif command -v k3s >/dev/null; then KUBECTL=(k3s kubectl); fi

# ------------------------------------------------------------ output
if [ -t 1 ]; then
  RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' BLU=$'\e[34m' CYN=$'\e[36m' BLD=$'\e[1m' BLINK=$'\e[5m' RST=$'\e[0m'
else
  RED="" GRN="" YLW="" BLU="" CYN="" BLD="" BLINK="" RST=""
fi
log()  { echo "${BLU}[$(date '+%F %T')]${RST} $*"; }
ok()   { log "${GRN}$*${RST}"; }
warn() { log "${YLW}$*${RST}"; }
err()  { log "${RED}$*${RST}"; }
hdr()  { echo "${CYN}${BLD}== $* ==${RST}"; }
die()  { err "❌ $*"; exit 1; }
run()  { if [ "$DRY_RUN" -eq 1 ]; then log "${YLW}DRY-RUN:${RST} $*"; else "$@"; fi; }

# ------------------------------------------------------------ notifications
dur() { if [ "$1" -ge 120 ]; then echo "$(( $1 / 60 )) min"; else echo "${1}s"; fi; }
json_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '%s' "$s"; }

# notify LEVEL TITLE MESSAGE — LEVEL: info|ok|warn|fail. Best effort; never fails the run.
notify() {
  local level=$1 title=$2 msg=$3 prio=default tags=information_source
  [ "${DRY_RUN:-0}" -eq 1 ] && return 0
  case "$level" in
    ok)   tags=white_check_mark ;;
    warn) prio=high;   tags=warning ;;
    fail) prio=urgent; tags=rotating_light ;;
  esac
  if [ -n "$NOTIFY_NTFY_URL" ]; then
    local -a h=(-H "Title: safe-power: $title" -H "Priority: $prio" -H "Tags: $tags")
    [ -n "$NOTIFY_NTFY_TOKEN" ] && h+=(-H "Authorization: Bearer $NOTIFY_NTFY_TOKEN")
    curl -fsS -m 10 "${h[@]}" -d "[$NODE_NAME] $msg" "$NOTIFY_NTFY_URL" >/dev/null 2>&1 \
      || warn "⚠️  ntfy notification failed ($NOTIFY_NTFY_URL)"
  fi
  if [ -n "$NOTIFY_HA_WEBHOOK" ]; then
    curl -fsS -m 10 -H 'Content-Type: application/json' \
      -d "{\"node\":\"$(json_esc "$NODE_NAME")\",\"level\":\"$level\",\"title\":\"$(json_esc "$title")\",\"message\":\"$(json_esc "$msg")\"}" \
      "$NOTIFY_HA_WEBHOOK" >/dev/null 2>&1 || warn "⚠️  Home Assistant notification failed"
  fi
  return 0
}

# abort TITLE MESSAGE — notify, then die
abort() { notify fail "$1" "$2"; die "$2"; }

# confirm_all WHAT NODE... — blinking red banner for whole-cluster actions; asks for "yes"
confirm_all() {
  local what=$1; shift
  echo
  echo "  ${BLINK}${RED}${BLD}⚠  ${what} OF $# NODE(S): $*  ⚠${RST}"
  echo "  ${RED}${BLD}This affects the whole cluster, starting from $NODE_NAME.${RST}"
  echo
  [ "$ASSUME_YES" -eq 1 ] || [ "$DRY_RUN" -eq 1 ] && return 0
  read -r -p "  Type yes to continue: " ans
  [[ "${ans,,}" == "yes" ]] || die "Aborted by user."
}
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SCRIPT_PATH"; exit "${1:-0}"; }

# ------------------------------------------------------------ service-account SSH
svc_ready() { [ -n "$SVC_HOME" ] && [ -f "$SVC_HOME/.ssh/id_ed25519" ]; }

# svc_ssh NODE WORD... — every word must be a plain token (checked by the gate)
svc_ssh() {
  local node=$1; shift
  sudo -u "$SVC_USER" ssh -i "$SVC_HOME/.ssh/id_ed25519" \
    -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$SVC_HOME/.ssh/known_hosts" \
    "$SVC_USER@$node" "$*"
}

# Forced command for the service account's authorized_keys. Only allows:
#   true | safe-power <action flags> | kubectl get|drain|cordon|uncordon ...
ssh_gate() {
  local -a w; local t
  read -ra w <<<"${SSH_ORIGINAL_COMMAND:-}"
  reject() { echo "safe-power gate: rejected: ${SSH_ORIGINAL_COMMAND:-<empty>}" >&2; logger -t safe-power "gate rejected: ${SSH_ORIGINAL_COMMAND:-}"; exit 126; }
  for t in "${w[@]}"; do [[ "$t" =~ ^[A-Za-z0-9._=/:,@-]+$ ]] || reject; done
  case "${w[0]:-}" in
    true) exit 0 ;;
    safe-power)
      for t in "${w[@]:1}"; do
        case "$t" in
          --reboot|--shutdown|--drain|--restore|--status|--check|-y|--yes|-n|--dry-run) ;;
          --wait-backups|--ignore-backups|--no-evict|--allow-concurrent) ;;
          --if-needed|--needs-reboot) ;;
          *) reject ;;
        esac
      done
      exec sudo -n "$SCRIPT_PATH" "${w[@]:1}" ;;
    kubectl)
      case "${w[1]:-}" in get|drain|cordon|uncordon) ;; *) reject ;; esac
      [ ${#KUBECTL[@]} -gt 0 ] || { echo "kubectl not installed" >&2; exit 127; }
      KUBECONFIG="$SVC_KUBECONFIG" exec "${KUBECTL[@]}" "${w[@]:1}" ;;
    *) reject ;;
  esac
}

# ------------------------------------------------------------ kubectl access
# 1) local kubectl + kubeconfig (service-account one first), else
# 2) kubectl on the control plane over service-account SSH.
KUBE_MODE=""
KUBE_LOCAL_CFG=""
kube_detect() {
  KUBE_MODE=""
  if [ ${#KUBECTL[@]} -gt 0 ]; then
    local cfg
    for cfg in "$SVC_KUBECONFIG" "${KUBECONFIG:-}" /etc/kubernetes/admin.conf \
               /etc/rancher/k3s/k3s.yaml /root/.kube/config; do
      [ -n "$cfg" ] && [ -r "$cfg" ] || continue
      if KUBECONFIG="$cfg" "${KUBECTL[@]}" get node "$NODE_NAME" --request-timeout=5s >/dev/null 2>&1; then
        KUBE_MODE="local"; KUBE_LOCAL_CFG="$cfg"; return 0
      fi
    done
  fi
  if [ "$ROLE" = "worker" ] && svc_ready && \
     svc_ssh "$CONTROL_PLANE_HOST" kubectl get node "$NODE_NAME" --request-timeout=5s >/dev/null 2>&1; then
    KUBE_MODE="ssh"; return 0
  fi
  return 1
}

# kube SUBCOMMAND ARGS... (subcommand first — the SSH gate checks it)
kube() {
  case "$KUBE_MODE" in
    local) KUBECONFIG="$KUBE_LOCAL_CFG" "${KUBECTL[@]}" "$@" ;;
    ssh)   svc_ssh "$CONTROL_PLANE_HOST" kubectl "$@" ;;
    *)     return 1 ;;
  esac
}

node_ready() {
  kube get node "$NODE_NAME" --no-headers --request-timeout=5s 2>/dev/null \
    | awk '{print $2}' | grep -Eq '^Ready(,|$)'
}

# ------------------------------------------------------------ Docker helpers
have_docker()      { command -v docker >/dev/null && docker info >/dev/null 2>&1; }
swarm_active()     { [ "$(docker info -f '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; }
swarm_task_count() { docker ps -q --filter label=com.docker.swarm.service.id | wc -l; }

# ------------------------------------------------------------ backup detection
# Prints one line per backup in progress; returns 0 if any were found.
# Host processes include those inside containers (same PID namespace view).
detect_backups() {
  local found="" pid cmd cid cname c
  while read -r pid cmd; do
    [ -z "$pid" ] && continue
    [[ " $cmd " =~ $BACKUP_IGNORE ]] && continue
    cname=""
    cid=$(grep -oE '[0-9a-f]{64}' "/proc/$pid/cgroup" 2>/dev/null | head -1)
    [ -n "$cid" ] && command -v docker >/dev/null && cname=$(docker inspect -f '{{.Name}}' "$cid" 2>/dev/null)
    found+="process ${cname:+[container ${cname#/}] }pid $pid: ${cmd:0:110}"$'\n'
  done < <(
    pgrep -a -x -- "$BACKUP_PROCS" 2>/dev/null
    [ -n "$BACKUP_CMDLINE" ] && pgrep -a -f -- "$BACKUP_CMDLINE" 2>/dev/null
  )
  # oneshot services show as "activating" while they run
  while read -r c; do
    [ -n "$c" ] && found+="systemd unit $c is running"$'\n'
  done < <(systemctl list-units --type=service --state=activating,deactivating --no-legend --plain 2>/dev/null \
           | awk '{print $1}' | grep -E -- "$BACKUP_UNITS")
  if have_docker; then
    for c in "${BLOCKING_CONTAINERS[@]}"; do
      while read -r cname; do
        [ -n "$cname" ] && found+="container $cname is running"$'\n'
      done < <(docker ps --format '{{.Names}}' | grep -- "$c")
    done
  fi
  [ -n "$found" ] || return 1
  sort -u <<<"${found%$'\n'}"
}

# ------------------------------------------------------------ container discovery
# Prints "tier<TAB>name<TAB>project<TAB>image" for every running container this
# node should stop itself: not Swarm tasks (Swarm drain moves them), not
# Kubernetes-managed (kubectl drain handles those), not labelled safe-power.skip.
discover_containers() {
  local name image proj swarm k8s tier skip base
  # '|' separator: tab is IFS whitespace, so read would merge empty fields
  docker ps --format '{{.Names}}|{{.Image}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.swarm.service.id"}}|{{.Label "io.kubernetes.pod.name"}}|{{.Label "safe-power.tier"}}|{{.Label "safe-power.skip"}}' |
  while IFS='|' read -r name image proj swarm k8s tier skip; do
    { [ -n "$swarm" ] || [ -n "$k8s" ] || [ "$skip" = "true" ]; } && continue
    if ! [[ "$tier" =~ ^[123]$ ]]; then
      # match the image's own name (no registry/owner/tag): postgres, bitnami/postgresql, mariadb:11 …
      base=${image##*/}; base=${base%%[:@]*}; base=${base,,}
      tier=1
      [[ "$base" =~ ^($DB_IMAGES)([-_]?($IMAGE_SUFFIXES))?$ ]]    && tier=2
      [[ "$base" =~ ^($INFRA_IMAGES)([-_]?($IMAGE_SUFFIXES))?$ ]] && tier=3
    fi
    printf '%s\t%s\t%s\t%s\n' "$tier" "$name" "${proj:--}" "$image"
  done | sort -t$'\t' -k1,1n -k3,3 -k2,2
}

tier_name() { case "$1" in 1) echo "apps" ;; 2) echo "data" ;; 3) echo "infra" ;; esac; }

# stop_tiers LIST — stop tier 1, then 2, then 3; report force-kills
stop_tiers() {
  local list=$1 t timeout c st
  local -a names
  for t in 1 2 3; do
    mapfile -t names < <(awk -F'\t' -v t="$t" '$1==t {print $2}' <<<"$list")
    [ ${#names[@]} -gt 0 ] || continue
    timeout=$STOP_TIMEOUT; [ "$t" -eq 2 ] && timeout=$DB_STOP_TIMEOUT
    log "🛑 Stopping tier $t ($(tier_name "$t")): ${names[*]} (timeout ${timeout}s)"
    run docker stop -t "$timeout" "${names[@]}" >/dev/null
    [ "$DRY_RUN" -eq 1 ] && continue
    for c in "${names[@]}"; do
      st=$(docker inspect -f '{{.State.Running}} {{.State.ExitCode}}' "$c" 2>/dev/null)
      case "$st" in
        true*)  err "❌ $c is still running" ;;
        *" 137") warn "⚠️  $c didn't stop within ${timeout}s and was killed — raise its timeout or check its shutdown" ;;
      esac
    done
  done
}

# wait_healthy NAME... — wait (up to HEALTH_WAIT) for containers that have a healthcheck
wait_healthy() {
  local deadline=$((SECONDS + HEALTH_WAIT)) c h pending
  while :; do
    pending=""
    for c in "$@"; do
      h=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$c" 2>/dev/null)
      [ -n "$h" ] && [ "$h" != "healthy" ] && pending+="$c($h) "
    done
    [ -z "$pending" ] && return 0
    [ "$SECONDS" -ge "$deadline" ] && { warn "⚠️  Not healthy after ${HEALTH_WAIT}s: $pending"; return 1; }
    sleep 5
  done
}

# ============================================================ PHASE 1 + 2
drain_and_power() {
  hdr "safe-power --$ACTION on $NODE_NAME ($ROLE)"

  if [ "$ACTION" = "reboot" ] && [ "$IF_NEEDED" -eq 1 ]; then
    local why
    if why=$(reboot_needed); then log "🩺 Reboot needed: $why"
    else ok "✅ No reboot needed on $NODE_NAME (--if-needed)"; return 0; fi
  fi

  # ---- Preflight: package manager + running backups
  if pgrep -x "apt|apt-get|dpkg|unattended-upgr" >/dev/null; then
    die "apt/dpkg is running. Try again when it finishes."
  fi
  local backups deadline
  if backups=$(detect_backups); then
    warn "💾 Backup in progress on $NODE_NAME:"; sed 's/^/     - /' <<<"$backups"
    if [ "$IGNORE_BACKUPS" -eq 1 ]; then
      warn "⚠️  --ignore-backups given; continuing anyway."
    elif [ "$DRY_RUN" -eq 1 ]; then
      warn "DRY-RUN: a real run would $([ "$BACKUP_WAIT" -gt 0 ] && echo "wait up to ${BACKUP_WAIT}s" || echo "abort") here."
    elif [ "$BACKUP_WAIT" -gt 0 ]; then
      log "⏳ Waiting up to ${BACKUP_WAIT}s for backups to finish"
      deadline=$((SECONDS + BACKUP_WAIT))
      while backups=$(detect_backups); do
        [ "$SECONDS" -ge "$deadline" ] && { sed 's/^/     - /' <<<"$backups"; abort "Backup still running" "Backups still running after ${BACKUP_WAIT}s; $NODE_NAME was not powered off."; }
        sleep 30
      done
      ok "✅ Backups finished"
    else
      abort "Backup in progress" "Not powering off $NODE_NAME during a backup. Re-run with --wait-backups to wait, or --ignore-backups to override."
    fi
  else
    ok "✅ No running backups detected"
  fi

  # ---- Discover local Docker containers
  local docker_ok=0 containers=""
  if have_docker; then
    docker_ok=1
    containers=$(discover_containers)
    if [ -n "$containers" ]; then
      log "🐳 Local containers to stop ($(grep -c . <<<"$containers")), in this order:"
      printf '     %-8s %-30s %-18s %s\n' "TIER" "CONTAINER" "PROJECT" "IMAGE"
      while IFS=$'\t' read -r t n p i; do
        printf '     %-8s %-30s %-18s %s\n' "$t $(tier_name "$t")" "$n" "$p" "$i"
      done <<<"$containers"
    else
      log "🐳 No local containers to stop"
    fi
  fi

  if kube_detect; then
    log "☸️  kubectl via $KUBE_MODE${KUBE_LOCAL_CFG:+ ($KUBE_LOCAL_CFG)}"
  elif [ "$NO_EVICT" -eq 1 ]; then
    warn "⚠️  kubectl not reachable (control plane may already be off); cluster shutdown continues without cordon."
  elif [ "$ROLE" = "worker" ]; then
    die "No kubectl access (local or via $SVC_USER@$CONTROL_PLANE_HOST). Run safe-power-setup. Refusing to power off an undrained worker."
  else
    warn "⚠️  kubectl not available; skipping Kubernetes drain."
  fi

  # Summary + confirm
  [ -n "$KUBE_MODE" ] && log "📋 Pods on $NODE_NAME: $(kube get pods -A --field-selector "spec.nodeName=$NODE_NAME" --no-headers 2>/dev/null | wc -l)"
  [ "$ROLE" = "control-plane" ] && [ "$ACTION" = "shutdown" ] && \
    warn "⚠️  Shutting down the control plane: workers keep running but the cluster can't be managed until it's back."

  if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    read -r -p "Proceed with ${ACTION^^} of $NODE_NAME? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
  fi

  if [ "$DRY_RUN" -ne 1 ]; then
    echo "$containers" > "$STATE_DIR/containers.txt"
    date '+%F %T'      > "$STATE_DIR/drained_at"
  fi

  # 1a. One-node-down lock: cordon ourselves first, then look for any other
  # node that is cordoned or NotReady. Two nodes racing both back off.
  if [ -n "$KUBE_MODE" ] && [ "$NO_EVICT" -ne 1 ] && [ "$ONE_AT_A_TIME" -eq 1 ] && [ "$ALLOW_CONCURRENT" -ne 1 ]; then
    log "🔒 One node down at a time: cordoning $NODE_NAME, then checking the other nodes"
    run kube cordon "$NODE_NAME" >/dev/null
    local others
    others=$(kube get nodes --no-headers --request-timeout=10s 2>/dev/null \
             | awk -v me="$NODE_NAME" '$1 != me && $2 != "Ready" {print $1" ("$2")"}')
    if [ -n "$others" ]; then
      run kube uncordon "$NODE_NAME" >/dev/null
      rm -f "$STATE_DIR/drained_at"
      abort "Another node is down" "Not draining $NODE_NAME: $(tr '\n' ' ' <<<"$others")is already cordoned or NotReady. Bring it back first, or use --allow-concurrent."
    fi
    ok "🔓 No other node is down"
  fi

  # 1b. Kubernetes drain (cluster-wide shutdown: cordon only — nowhere to evict to)
  if [ -n "$KUBE_MODE" ] && [ "$NO_EVICT" -eq 1 ]; then
    log "🚧 Cluster shutdown: cordoning $NODE_NAME (no eviction)"
    run kube cordon "$NODE_NAME" >/dev/null || warn "⚠️  cordon failed; continuing shutdown"
  elif [ -n "$KUBE_MODE" ]; then
    log "🚰 kubectl drain $NODE_NAME ${DRAIN_ARGS[*]}"
    if ! run kube drain "$NODE_NAME" "${DRAIN_ARGS[@]}" "--timeout=${DRAIN_TIMEOUT}s"; then
      warn "↩️  Drain failed; uncordoning $NODE_NAME"
      kube uncordon "$NODE_NAME" >/dev/null
      rm -f "$STATE_DIR/drained_at"
      abort "Drain failed" "kubectl drain of $NODE_NAME failed (PodDisruptionBudget? stuck pod?). Nothing was powered off."
    fi
  fi

  # 1b. Docker Swarm drain
  if [ "$docker_ok" -eq 1 ] && swarm_active; then
    local nid; nid=$(docker info -f '{{.Swarm.NodeID}}')
    [ "$DRY_RUN" -ne 1 ] && echo "$nid" > "$STATE_DIR/swarm_node_id"
    log "🚰 Draining swarm node $nid"
    run docker node update --availability drain "$nid" >/dev/null || warn "⚠️  Swarm drain failed; continuing."
    if [ "$DRY_RUN" -ne 1 ]; then
      local waited=0
      while [ "$(swarm_task_count)" -gt 0 ] && [ "$waited" -lt "$DRAIN_TIMEOUT" ]; do
        sleep 5; waited=$((waited + 5))
      done
    fi
  fi

  # 1c. Local containers: apps → data → infra
  [ -n "$containers" ] && stop_tiers "$containers"

  # Arm the restore unit
  log "🔧 Enabling $UNIT_NAME for restore on next boot"
  if [ "$DRY_RUN" -ne 1 ]; then
    cat > "$UNIT_FILE" <<EOF
[Unit]
Description=safe-power restore after drain
After=network-online.target remote-fs.target docker.service kubelet.service k3s.service k3s-agent.service
Wants=network-online.target
ConditionPathExists=${STATE_DIR}/drained_at

[Service]
Type=oneshot
ExecStart=${SCRIPT_PATH} --restore
TimeoutStartSec=$((CONVERGE_TIMEOUT * 2 + 120))

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable "$UNIT_NAME" >/dev/null 2>&1
  fi

  # 2. Power action
  case "$ACTION" in
    drain)
      ok "✅ Drained. Run 'safe-power --restore' to bring $NODE_NAME back."
      notify info "Drained" "$NODE_NAME is drained. Bring it back with: safe-power --restore $NODE_NAME" ;;
    reboot)
      notify info "Rebooting" "$NODE_NAME drained cleanly and is rebooting."
      log "💾 sync"; run sync; ok "🔁 Rebooting $NODE_NAME"; run systemctl reboot ;;
    shutdown)
      notify warn "Powering off" "$NODE_NAME drained and is powering off. Restore runs at next power-on."
      log "💾 sync"; run sync; ok "⏻  Powering off $NODE_NAME"; run systemctl poweroff ;;
  esac
}

# ============================================================ PHASE 3
restore() {
  hdr "safe-power --restore on $NODE_NAME ($ROLE)"
  local failures=0 deadline

  # Required mounts first: containers must not start on an empty mount point
  if [ ${#REQUIRED_MOUNTS[@]} -gt 0 ]; then
    local badm=0
    wait_mounts || badm=$?
    if [ "$badm" -gt 0 ]; then
      # Stop here: no containers, no uncordon. The node stays drained and the
      # restore unit stays armed, so the next boot (or a manual --restore) retries.
      echo "failed: $badm required mount(s) missing $(date '+%F %T')" > "$STATE_DIR/last_result"
      err "🛑 Not starting containers or uncordoning $NODE_NAME until the mount is back. Fix it, then run: safe-power --restore"
      notify fail "Mount missing" "$badm required mount(s) not up on $NODE_NAME: ${REQUIRED_MOUNTS[*]}. Node left drained; fix it, then: safe-power --restore $NODE_NAME"
      exit 1
    fi
  fi

  # Docker side
  if command -v docker >/dev/null; then
    deadline=$((SECONDS + 120))
    until have_docker || [ "$SECONDS" -ge "$deadline" ]; do sleep 5; done
    if have_docker; then
      if swarm_active; then
        local nid; nid=$(cat "$STATE_DIR/swarm_node_id" 2>/dev/null || docker info -f '{{.Swarm.NodeID}}')
        log "🔌 Swarm node $nid → active"
        docker node update --availability active "$nid" >/dev/null || { err "❌ Swarm activate failed"; failures=$((failures + 1)); }
      fi
      # Start in reverse tier order: infra → data → apps, waiting for healthchecks in between
      if [ -s "$STATE_DIR/containers.txt" ]; then
        local t c; local -a names started
        for t in 3 2 1; do
          # old state files hold bare names → tier 1
          mapfile -t names < <(awk -F'\t' -v t="$t" 'NF==1 && $1!="" && t==1 {print $1} NF>1 && $1==t {print $2}' "$STATE_DIR/containers.txt")
          [ ${#names[@]} -gt 0 ] || continue
          log "▶️  Starting tier $t ($(tier_name "$t")): ${names[*]}"
          started=()
          for c in "${names[@]}"; do
            if [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = "true" ]; then
              started+=("$c")
            elif docker start "$c" >/dev/null; then
              started+=("$c")
            else
              err "❌ Failed to start $c"; failures=$((failures + 1))
            fi
          done
          [ ${#started[@]} -gt 0 ] && { wait_healthy "${started[@]}" || failures=$((failures + 1)); }
        done
      fi
    else
      err "❌ Docker didn't come up"; failures=$((failures + 1))
    fi
  fi

  # Kubernetes: wait for Ready, then uncordon
  deadline=$((SECONDS + CONVERGE_TIMEOUT))
  until kube_detect || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
  if [ -n "$KUBE_MODE" ]; then
    log "⏳ Waiting for $NODE_NAME to be Ready"
    until node_ready || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
    if node_ready; then
      ok "✅ $NODE_NAME is Ready — uncordoning"
      kube uncordon "$NODE_NAME" >/dev/null || { err "❌ uncordon failed"; failures=$((failures + 1)); }
    else
      err "❌ $NODE_NAME not Ready after ${CONVERGE_TIMEOUT}s — left cordoned"; failures=$((failures + 1))
    fi
  elif [ ${#KUBECTL[@]} -gt 0 ] || [ "$ROLE" = "worker" ]; then
    err "❌ kubectl unreachable. On $CONTROL_PLANE_HOST run: kubectl uncordon $NODE_NAME"
    failures=$((failures + 1))
  fi

  # Swarm services converge (N/N; ignore completed jobs)
  if have_docker && swarm_active; then
    deadline=$((SECONDS + CONVERGE_TIMEOUT))
    local pending
    while :; do
      pending=$(docker service ls --format '{{.Name}} {{.Replicas}}' | grep -v completed \
                | awk '{split($2,r,"/"); if (r[1]!=r[2]) print $1" ("$2")"}')
      [ -z "$pending" ] && { ok "✅ Swarm services converged"; break; }
      if [ "$SECONDS" -ge "$deadline" ]; then
        err "❌ Swarm services not converged:"; sed 's/^/     - /' <<<"$pending"
        failures=$((failures + 1)); break
      fi
      sleep 10
    done
  fi

  # Health checks (control plane only)
  if [ "$ROLE" = "control-plane" ]; then
    local url code
    for url in "${HEALTH_URLS[@]}"; do
      deadline=$((SECONDS + CONVERGE_TIMEOUT))
      while :; do
        code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$url")
        if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then ok "✅ $url → HTTP $code"; break; fi
        if [ "$SECONDS" -ge "$deadline" ]; then
          err "❌ $url unhealthy (HTTP $code)"; failures=$((failures + 1)); break
        fi
        sleep 10
      done
    done
  fi

  # Disarm + record result (read by --status)
  systemctl disable "$UNIT_NAME" >/dev/null 2>&1
  rm -f "$UNIT_FILE" "$STATE_DIR/drained_at"
  systemctl daemon-reload

  if [ "$failures" -gt 0 ]; then
    echo "failed $failures problem(s) $(date '+%F %T')" > "$STATE_DIR/last_result"
    warn "⚠️  Restore finished with $failures problem(s). See $LOG_FILE"
    notify fail "Restore failed" "$NODE_NAME came back with $failures problem(s). See $LOG_FILE on $NODE_NAME."
    exit 1
  fi
  echo "ok restored $(date '+%F %T')" > "$STATE_DIR/last_result"
  ok "🎉 Restore complete — $NODE_NAME is healthy."
  notify ok "Restored" "$NODE_NAME is back, uncordoned and healthy."
}

# ============================================================ status / check
status() {
  # a restore that stopped early (e.g. mount missing) leaves the node drained
  # but must still read as failed, so a waiting rollout stops instead of timing out
  if [ -f "$STATE_DIR/drained_at" ] && [ "$STATE_DIR/last_result" -nt "$STATE_DIR/drained_at" ] \
     && grep -q '^failed' "$STATE_DIR/last_result"; then
    echo "$(cat "$STATE_DIR/last_result") — still drained since $(cat "$STATE_DIR/drained_at")"
  elif [ -f "$STATE_DIR/drained_at" ]; then echo "drained since $(cat "$STATE_DIR/drained_at")"
  elif [ -s "$STATE_DIR/last_result" ]; then cat "$STATE_DIR/last_result"
  else echo "ok"; fi
  local t
  while read -r t; do
    [ -n "$t" ] && echo "   scheduled: $(awk '{print $1, $2, $3}' <<<"$t") → $(grep -oE 'safe-power-at-[0-9-]+' <<<"$t" | head -1)"
  done < <(scheduled_timers)
}

check() {
  local f=0 n
  chk() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then echo "  ${GRN}✔${RST} $label"; else echo "  ${RED}✘${RST} $label"; f=$((f + 1)); fi
  }
  hdr "safe-power check — $NODE_NAME ($ROLE)"
  chk "cluster.conf (control plane: $CONTROL_PLANE_HOST, nodes: ${NODES[*]:-none})" test -r "$CONF_DIR/cluster.conf"
  chk "service account '$SVC_USER'"          id "$SVC_USER"
  chk "passphrase-less SSH key"              svc_ready
  chk "sudoers rule (/etc/sudoers.d/safe-power)" test -f /etc/sudoers.d/safe-power
  if [ -n "$SVC_HOME" ] && [ -s "$SVC_HOME/.ssh/authorized_keys" ]; then
    local total limited
    total=$(grep -c 'ssh-' "$SVC_HOME/.ssh/authorized_keys")
    limited=$(grep -c '^from="' "$SVC_HOME/.ssh/authorized_keys")
    if [ "$limited" -eq "$total" ]; then echo "  ${GRN}✔${RST} all $total trusted keys limited to their node's addresses (from=)"
    else echo "  ${YLW}●${RST} $limited of $total trusted keys limited by from= (re-run safe-power-setup to add it)"; fi
  fi
  local m
  for m in "${REQUIRED_MOUNTS[@]}"; do chk "required mount $m" mount_ok "$m"; done
  if kube_detect; then
    echo "  ${GRN}✔${RST} kubectl via $KUBE_MODE${KUBE_LOCAL_CFG:+ ($KUBE_LOCAL_CFG)}"
  else
    echo "  ${RED}✘${RST} kubectl access"; f=$((f + 1))
  fi
  for n in "${NODES[@]}"; do
    [ "$n" = "$NODE_NAME" ] && continue
    chk "ssh $SVC_USER → $n" svc_ssh "$n" true
  done
  [ "$f" -eq 0 ] && echo "  ${GRN}${BLD}all checks passed${RST}" || echo "  ${RED}${BLD}$f check(s) failed${RST}"
  return "$f"
}

# ============================================================ remote target
wait_for_restore() {
  local n=$1 st deadline=$((SECONDS + CONVERGE_TIMEOUT * 2 + 600))
  # a rollout's time limit caps the wait too
  [ -n "${ROLL_DEADLINE:-}" ] && [ "$ROLL_DEADLINE" -lt "$deadline" ] && deadline=$ROLL_DEADLINE
  log "⏳ Waiting for $n to reboot and restore (Ctrl+C stops waiting; restore still runs on $n)"
  sleep 20
  while [ "$SECONDS" -lt "$deadline" ]; do
    st=$(svc_ssh "$n" safe-power --status 2>/dev/null) || st="unreachable"
    case "$st" in
      ok*)     ok "✅ $n is back: $st"; return 0 ;;
      failed*) err "❌ $n restore: $st (see $LOG_FILE on $n)"; return 1 ;;
    esac
    sleep 15
  done
  err "❌ Timed out waiting for $n. Check: safe-power --status $n"; return 1
}

# remote_action NODE — run $ACTION on NODE (no prompt); returns non-zero on failure
remote_action() {
  local n=$1 rc args=("--$ACTION")
  case "$ACTION" in reboot|shutdown|drain|restore) args+=(-y) ;; esac
  [ "$DRY_RUN" -eq 1 ] && args+=(--dry-run)
  if [ "$ACTION" = "reboot" ] && [ "$IF_NEEDED" -eq 1 ]; then
    local why nrc
    why=$(node_needs_reboot "$n"); nrc=$?
    case "$nrc" in
      0) log "🩺 $n needs a reboot: $why" ;;
      1) ok "✅ $n doesn't need a reboot — skipping"; return 0 ;;
      *) err "❌ Can't ask $n whether it needs a reboot ($why)."; return 1 ;;
    esac
  fi
  case "$ACTION" in
    reboot|shutdown|drain)
      [ "$WAIT_BACKUPS" -eq 1 ]     && args+=(--wait-backups)
      [ "$IGNORE_BACKUPS" -eq 1 ]   && args+=(--ignore-backups)
      [ "$NO_EVICT" -eq 1 ]         && args+=(--no-evict)
      [ "$ALLOW_CONCURRENT" -eq 1 ] && args+=(--allow-concurrent) ;;
  esac

  log "📡 $NODE_NAME → $n: safe-power ${args[*]}"
  svc_ssh "$n" safe-power "${args[@]}"; rc=$?

  case "$ACTION" in
    reboot)
      # 255 = connection dropped by the reboot
      if [ "$rc" -ne 0 ] && [ "$rc" -ne 255 ]; then err "❌ safe-power on $n failed (rc=$rc)."; return 1; fi
      [ "$DRY_RUN" -eq 1 ] || [ "$NO_WAIT" -eq 1 ] && return 0
      wait_for_restore "$n" ;;
    shutdown)
      if [ "$rc" -ne 0 ] && [ "$rc" -ne 255 ]; then err "❌ safe-power on $n failed (rc=$rc)."; return 1; fi
      ok "⏻  $n is powering off. Restore runs automatically at next power-on." ;;
    *) return "$rc" ;;
  esac
}

remote_dispatch() {
  local n=$TARGET
  if [ ${#NODES[@]} -gt 0 ] && [[ " ${NODES[*]} " != *" $n "* ]]; then
    die "'$n' is not in NODES (${NODES[*]}). Add it with safe-power-setup."
  fi
  svc_ready || die "No $SVC_USER SSH key on $NODE_NAME. Run safe-power-setup."
  svc_ssh "$n" true 2>/dev/null || die "Can't reach $SVC_USER@$n over SSH. Try: safe-power --check"

  case "$ACTION" in
    reboot|shutdown|drain|restore)
      if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
        read -r -p "Proceed with ${ACTION^^} of ${n} (from $NODE_NAME)? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
      fi ;;
  esac
  remote_action "$n"; exit $?
}

# ============================================================ --all
node_status() { if [ "$1" = "$NODE_NAME" ]; then status; else svc_ssh "$1" safe-power --status 2>/dev/null || echo "unreachable"; fi; }

# Nodes selected by --all (minus the control plane with --workers-only)
SELECTED=()
select_nodes() {
  local n; SELECTED=()
  for n in "${NODES[@]}"; do
    [ "$WORKERS_ONLY" -eq 1 ] && [ "$n" = "$CONTROL_PLANE_HOST" ] && continue
    SELECTED+=("$n")
  done
  [ ${#SELECTED[@]} -gt 0 ] || die "No nodes selected."
}

# ORDER: other workers → control plane → this node last (the run ends when it goes down)
ORDER=()
build_order() {
  local n; ORDER=()
  select_nodes
  for n in "${SELECTED[@]}"; do
    [ "$n" = "$CONTROL_PLANE_HOST" ] || [ "$n" = "$NODE_NAME" ] || ORDER+=("$n")
  done
  [ "$CONTROL_PLANE_HOST" != "$NODE_NAME" ] && [[ " ${SELECTED[*]} " == *" $CONTROL_PLANE_HOST "* ]] && ORDER+=("$CONTROL_PLANE_HOST")
  [[ " ${SELECTED[*]} " == *" $NODE_NAME "* ]] && ORDER+=("$NODE_NAME")
  [ ${#ORDER[@]} -gt 0 ] || die "No nodes to act on."
}

status_all() {
  local n
  select_nodes
  hdr "safe-power status — $([ "$WORKERS_ONLY" -eq 1 ] && echo "workers" || echo "all nodes")"
  for n in "${SELECTED[@]}"; do
    local st; st=$(node_status "$n")
    case "$st" in
      ok*)      printf '  %s✔%s %-20s %s\n' "$GRN" "$RST" "$n" "$st" ;;
      drained*) printf '  %s●%s %-20s %s\n' "$YLW" "$RST" "$n" "$st" ;;
      *)        printf '  %s✘%s %-20s %s\n' "$RED" "$RST" "$n" "$st" ;;
    esac
  done
}

check_all() {
  local n f=0
  select_nodes
  for n in "${SELECTED[@]}"; do
    if [ "$n" = "$NODE_NAME" ]; then check || f=$((f + 1))
    else svc_ssh "$n" safe-power --check || f=$((f + 1)); fi
  done
  return "$f"
}

# Rolling reboot: other workers → control plane → this node last.
# Stops at the first node that doesn't come back healthy, or at the time limit.
rolling_all() {
  local n i=0 bad
  svc_ready || die "No $SVC_USER SSH key on $NODE_NAME. Run safe-power-setup."
  build_order
  local -a order=("${ORDER[@]}")

  if [ "$IF_NEEDED" -eq 1 ]; then
    local -a needed=(); local why nrc
    for n in "${order[@]}"; do
      why=$(node_needs_reboot "$n"); nrc=$?
      case "$nrc" in
        0) log "🩺 $n: $why"; needed+=("$n") ;;
        1) log "✔  $n: no reboot needed" ;;
        *) die "Can't ask $n whether it needs a reboot ($why). Nothing was started; fix it (safe-power --check --all) and try again." ;;
      esac
    done
    if [ ${#needed[@]} -eq 0 ]; then ok "✅ No node needs a reboot."; return 0; fi
    order=("${needed[@]}")
    IF_NEEDED=0   # already filtered; don't ask each node again
  fi

  hdr "Rolling reboot ${WORKERS_ONLY_LABEL}from $NODE_NAME: ${order[*]}"
  [ "$ROLL_MAX" -gt 0 ] && log "⏱️  Time limit: no new node starts after $(dur "$ROLL_MAX")"

  # Preflight: every node reachable, none already drained, cluster fully Ready + schedulable
  for n in "${order[@]}"; do
    if [ "$n" != "$NODE_NAME" ]; then
      svc_ssh "$n" true 2>/dev/null || die "Can't reach $SVC_USER@$n. Fix before a rolling reboot (safe-power --check --all)."
    fi
    [[ "$(node_status "$n")" == drained* ]] && die "$n is already drained. Run: safe-power --restore $n"
  done
  if kube_detect; then
    bad=$(kube get nodes --no-headers --request-timeout=10s 2>/dev/null | awk '$2 != "Ready" {print $1" ("$2")"}')
    [ -n "$bad" ] && die "Not all nodes are Ready + schedulable: $(tr '\n' ' ' <<<"$bad")— fix or uncordon first."
    ok "✅ All Kubernetes nodes Ready and schedulable"
  else
    warn "⚠️  kubectl not reachable from $NODE_NAME; skipping cluster-wide Ready check."
  fi

  confirm_all "ROLLING REBOOT" "${order[@]}"
  notify info "Rolling reboot started" "From $NODE_NAME: ${order[*]}"

  NO_WAIT=0
  [ "$ROLL_MAX" -gt 0 ] && ROLL_DEADLINE=$((SECONDS + ROLL_MAX))
  for n in "${order[@]}"; do
    if [ -n "${ROLL_DEADLINE:-}" ] && [ "$SECONDS" -ge "$ROLL_DEADLINE" ]; then
      abort "Rolling reboot stopped" "Time limit of $(dur "$ROLL_MAX") reached. Done: ${order[*]:0:$i}. Not started: ${order[*]:$i}"
    fi
    i=$((i + 1))
    hdr "[$i/${#order[@]}] $n"
    if [ "$n" = "$NODE_NAME" ]; then
      log "🔁 This node goes last; its restore runs on boot. Check later: safe-power --status --all"
      notify info "Rolling reboot: last node" "Others done; $NODE_NAME reboots now. Its restore reports when it's back."
      ASSUME_YES=1; drain_and_power; return
    fi
    remote_action "$n" || abort "Rolling reboot stopped" "$n didn't come back healthy. Not started: ${order[*]:$i}"
    if [ "$i" -lt "${#order[@]}" ] && [ "$DRY_RUN" -ne 1 ]; then
      log "😴 Letting workloads settle for ${ROLL_PAUSE}s"; sleep "$ROLL_PAUSE"
    fi
  done
  ok "🎉 Rolling reboot complete: ${order[*]}"
  notify ok "Rolling reboot complete" "${order[*]}"
}

# Cluster shutdown (UPS / power outage): workers in parallel → control plane → this node.
# Cordon only (no eviction: there's nowhere to evict to). Best effort: a failed or
# unreachable node doesn't stop the rest from powering off.
shutdown_all() {
  local n rc fails=0 cp="" self=""
  local -a workers=() pids=() pnames=()
  svc_ready || die "No $SVC_USER SSH key on $NODE_NAME. Run safe-power-setup."
  build_order
  for n in "${ORDER[@]}"; do
    if   [ "$n" = "$NODE_NAME" ];          then self=$n
    elif [ "$n" = "$CONTROL_PLANE_HOST" ]; then cp=$n
    elif svc_ssh "$n" true 2>/dev/null;    then workers+=("$n")
    else warn "⚠️  $n unreachable (already off?) — skipping"
    fi
  done
  if [ -n "$cp" ] && ! svc_ssh "$cp" true 2>/dev/null; then
    warn "⚠️  $cp unreachable (already off?) — skipping"; cp=""
  fi

  hdr "Cluster SHUTDOWN ${WORKERS_ONLY_LABEL}from $NODE_NAME"
  log "   1) workers, in parallel: ${workers[*]:-none}"
  log "   2) control plane:        ${cp:-none}"
  log "   3) this node, last:      ${self:-none}"
  confirm_all "SHUTDOWN" ${workers[@]+"${workers[@]}"} ${cp:+"$cp"} ${self:+"$self"}
  notify warn "Cluster shutdown started" "From $NODE_NAME: ${workers[*]} ${cp} ${self}"

  NO_EVICT=1
  if [ ${#workers[@]} -gt 0 ]; then
    hdr "Workers: ${workers[*]}"
    for n in "${workers[@]}"; do
      ( remote_action "$n" 2>&1 | sed -u "s/^/[$n] /"; exit "${PIPESTATUS[0]}" ) &
      pids+=($!); pnames+=("$n")
    done
    for i in "${!pids[@]}"; do
      wait "${pids[$i]}"; rc=$?
      [ "$rc" -eq 0 ] || { err "❌ ${pnames[$i]} did not shut down cleanly (rc=$rc)"; fails=$((fails + 1)); }
    done
  fi
  if [ -n "$cp" ]; then
    hdr "Control plane: $cp"
    remote_action "$cp" || { err "❌ $cp did not shut down cleanly"; fails=$((fails + 1)); }
  fi
  if [ "$fails" -gt 0 ]; then
    notify fail "Cluster shutdown problems" "$fails node(s) did not shut down cleanly; see $LOG_FILE on $NODE_NAME."
  fi
  if [ -n "$self" ]; then
    hdr "This node: $self"
    ASSUME_YES=1; drain_and_power; return
  fi
  ok "⏻  Cluster shutdown sent to all selected nodes."
}

# ============================================================ --if-needed
# reboot_needed — prints the reason and returns 0 if this node needs a reboot
reboot_needed() {
  if [ -f "$REBOOT_REQUIRED_FILE" ]; then
    local pkgs=""
    [ -s "$REBOOT_REQUIRED_FILE.pkgs" ] && pkgs=" ($(sort -u "$REBOOT_REQUIRED_FILE.pkgs" | head -5 | tr '\n' ' ' | sed 's/ $//'))"
    echo "updates need a reboot$pkgs"; return 0
  fi
  if command -v needs-restarting >/dev/null; then       # RHEL / Fedora (dnf-utils)
    needs-restarting -r >/dev/null 2>&1
    [ $? -eq 1 ] && { echo "needs-restarting -r says so"; return 0; }
  fi
  local running newest
  running=$(uname -r)
  newest=$(find "$BOOT_DIR" -maxdepth 1 -name 'vmlinuz-*' 2>/dev/null | sed 's#.*/vmlinuz-##' | grep -v rescue | sort -V | tail -1)
  # only a strictly NEWER installed kernel counts (old ones may have been removed)
  if [ -n "$newest" ] && [ "$newest" != "$running" ] && \
     [ "$(printf '%s\n%s\n' "$running" "$newest" | sort -V | tail -1)" = "$newest" ]; then
    echo "kernel $newest installed, $running running"; return 0
  fi
  return 1
}

# node_needs_reboot NODE — same, for any node (remote via the gate).
# Returns 0 = yes (prints reason), 1 = no, 2 = couldn't ask (prints why).
node_needs_reboot() {
  if [ "$1" = "$NODE_NAME" ]; then reboot_needed; return; fi
  local out
  out=$(svc_ssh "$1" safe-power --needs-reboot 2>/dev/null)
  case "$out" in
    yes*) echo "${out#yes: }"; return 0 ;;
    no)   return 1 ;;
    *)    echo "unreachable or no answer"; return 2 ;;
  esac
}

needs_reboot_all() {
  local n reason rc
  select_nodes
  hdr "Reboot needed?"
  for n in "${SELECTED[@]}"; do
    reason=$(node_needs_reboot "$n"); rc=$?
    case "$rc" in
      0) printf '  %s●%s %-20s yes — %s\n' "$YLW" "$RST" "$n" "$reason" ;;
      1) printf '  %s✔%s %-20s no\n' "$GRN" "$RST" "$n" ;;
      *) printf '  %s✘%s %-20s ? — %s\n' "$RED" "$RST" "$n" "$reason" ;;
    esac
  done
}

# ============================================================ --at / --cancel
# schedule_at WHEN — run this same command later as a one-shot systemd timer.
# Transient: a reboot of THIS node before WHEN cancels it.
schedule_at() {
  local when=$1 now target unit a
  local -a args=()
  now=$(date +%s)
  target=$(date -d "$when" +%s 2>/dev/null) || die "Can't read --at '$when'. Try 03:00, 'tomorrow 02:30' or '2026-10-03 04:00'."
  # a bare HH:MM that has already passed today means tomorrow
  if [ "$target" -le "$now" ] && [[ "$when" =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
    target=$(date -d "tomorrow $when" +%s)
  fi
  [ "$target" -gt "$now" ] || die "--at '$when' is in the past."
  for a in "${PASS_ARGS[@]}"; do case "$a" in -n|--dry-run|-y|--yes) ;; *) args+=("$a") ;; esac; done
  args+=(-y)
  unit="safe-power-at-$(date -d "@$target" +%Y%m%d-%H%M%S)"

  hdr "Schedule: safe-power ${args[*]}"
  log "🗓️  At $(date -d "@$target" '+%a %F %T') (in $(dur $((target - now))))"
  if [ "$ALL" -eq 1 ] && [ "$ACTION" != "drain" ]; then
    local -a who=()
    build_order; who=("${ORDER[@]}")
    confirm_all "SCHEDULED ${ACTION^^}$([ "$IF_NEEDED" -eq 1 ] && echo " (ONLY IF NEEDED)")" "${who[@]}"
  elif [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    read -r -p "Schedule ${ACTION^^} of ${TARGET:-$NODE_NAME} for $(date -d "@$target" '+%a %F %T')? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
  fi
  run systemd-run --quiet --unit="$unit" --description="safe-power ${args[*]}" \
      --on-active="$((target - now))s" --timer-property=AccuracySec=1s \
      "$SCRIPT_PATH" "${args[@]}" || die "systemd-run failed."
  if [ "$DRY_RUN" -eq 1 ]; then
    ok "DRY-RUN: would schedule $unit.timer (nothing was scheduled)"; return 0
  fi
  ok "✅ Scheduled as $unit.timer. Cancel with: safe-power --cancel"
  notify info "Scheduled" "safe-power ${args[*]} at $(date -d "@$target" '+%a %F %T') (from $NODE_NAME)"
}

scheduled_timers() {
  systemctl list-timers --all --no-legend --plain 'safe-power-at-*' 2>/dev/null | awk 'NF {print}'
}

cancel_scheduled() {
  local line unit n=0
  while read -r line; do
    unit=$(grep -oE 'safe-power-at-[0-9-]+\.timer' <<<"$line") || continue
    run systemctl stop "$unit" && { ok "🗑️  Cancelled $unit"; n=$((n + 1)); }
  done < <(scheduled_timers)
  [ "$n" -gt 0 ] || log "Nothing scheduled."
}

# ============================================================ required mounts
mount_ok() { findmnt -rn --mountpoint "$1" >/dev/null 2>&1 && timeout 10 stat -f "$1" >/dev/null 2>&1; }

# wait_mounts — returns the number of REQUIRED_MOUNTS that never came up
wait_mounts() {
  local m bad=0 deadline tried
  for m in "${REQUIRED_MOUNTS[@]}"; do
    deadline=$((SECONDS + MOUNT_WAIT)); tried=0
    until mount_ok "$m"; do
      if [ "$tried" -eq 0 ]; then
        # one attempt, bounded by what's left of MOUNT_WAIT (a dead NFS server can hang mount)
        log "📂 $m not mounted yet — trying: mount $m"
        timeout -k 5 "$(( deadline - SECONDS > 1 ? deadline - SECONDS : 1 ))" mount "$m" >/dev/null 2>&1
        tried=1
      fi
      [ "$SECONDS" -ge "$deadline" ] && break
      sleep 5
    done
    if mount_ok "$m"; then ok "✅ $m is mounted"
    else err "❌ $m is NOT mounted after ${MOUNT_WAIT}s — anything writing there is writing to the local disk"; bad=$((bad + 1)); fi
  done
  return "$bad"
}

# ============================================================ main
[ "${1:-}" = "--ssh-gate" ] && ssh_gate

ORIG_ARGS=("$@")
ACTION=""; TARGET=""; ASSUME_YES=0; DRY_RUN=0; NO_WAIT=0; ALL=0; WAIT_BACKUPS=0; IGNORE_BACKUPS=0
WORKERS_ONLY=0; WORKERS_ONLY_LABEL=""; NO_EVICT=0; ALLOW_CONCURRENT=0; IF_NEEDED=0; AT=""
PASS_ARGS=()   # everything except --at, for the scheduled run
while [ $# -gt 0 ]; do
  arg=$1; shift
  case "$arg" in
    --at)   [ $# -gt 0 ] || { echo "--at needs a time, e.g. --at 03:00" >&2; usage 2; }; AT=$1; shift; continue ;;
    --at=*) AT=${arg#--at=}; continue ;;
  esac
  PASS_ARGS+=("$arg")
  case "$arg" in
    --reboot|--shutdown|--drain|--restore|--status|--check|--needs-reboot|--cancel) ACTION="${arg#--}" ;;
    --all)        ALL=1 ;;
    --workers-only)     WORKERS_ONLY=1; WORKERS_ONLY_LABEL="(workers only) " ;;
    --max-time=*)
      [[ "${arg#--max-time=}" =~ ^[0-9]+$ ]] || { echo "--max-time=MINUTES needs a whole number" >&2; usage 2; }
      ROLL_MAX=$(( ${arg#--max-time=} * 60 )) ;;
    --no-evict)         NO_EVICT=1 ;;
    --allow-concurrent) ALLOW_CONCURRENT=1 ;;
    --if-needed)        IF_NEEDED=1 ;;
    -y|--yes)     ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --no-wait)    NO_WAIT=1 ;;
    --wait-backups)   WAIT_BACKUPS=1; [ "$BACKUP_WAIT" -gt 0 ] || BACKUP_WAIT=3600 ;;
    --ignore-backups) IGNORE_BACKUPS=1 ;;
    -h|--help)    usage 0 ;;
    -*) echo "Unknown option: $arg" >&2; usage 2 ;;
    *)  [ -z "$TARGET" ] || { echo "Only one NODE allowed" >&2; usage 2; }; TARGET="$arg" ;;
  esac
done
[ -n "$ACTION" ] || { echo "Choose an action: --reboot --shutdown --drain --restore --status --check --needs-reboot --cancel" >&2; usage 2; }
[ "$TARGET" = "$NODE_NAME" ] || [ "$TARGET" = "localhost" ] && TARGET=""
[ "$WORKERS_ONLY" -eq 1 ] && [ "$ALL" -ne 1 ] && { echo "--workers-only needs --all" >&2; usage 2; }
[ "$IF_NEEDED" -eq 1 ] && [ "$ACTION" != "reboot" ] && { echo "--if-needed only works with --reboot" >&2; usage 2; }
if [ -n "$AT" ]; then
  case "$ACTION" in reboot|shutdown|drain) ;; *) echo "--at only works with --reboot, --shutdown or --drain" >&2; usage 2 ;; esac
fi

# Require root: re-exec through sudo (prompts for password if needed)
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null || { echo "❌ Must run as root and sudo is not installed." >&2; exit 1; }
  exec sudo -- "$SCRIPT_PATH" "${ORIG_ARGS[@]}"
fi

if [ "$ALL" -eq 1 ]; then
  [ -z "$TARGET" ] || die "Use either NODE or --all, not both."
  [ ${#NODES[@]} -gt 0 ] || die "NODES is empty in $CONF_DIR/cluster.conf. Run safe-power-setup."
  case "$ACTION" in
    status)       status_all;       exit 0 ;;
    check)        check_all;        exit $? ;;
    needs-reboot) needs_reboot_all; exit 0 ;;
    reboot|shutdown) ;;
    *) die "--all works with --reboot, --shutdown, --status, --check and --needs-reboot." ;;
  esac
elif [ -z "$TARGET" ]; then
  case "$ACTION" in
    status)       status; exit 0 ;;
    check)        check;  exit $? ;;
    needs-reboot) if reason=$(reboot_needed); then echo "yes: $reason"; exit 0; else echo "no"; exit 1; fi ;;
  esac
fi
[ "$ACTION" = "cancel" ] && { cancel_scheduled; exit $?; }

mkdir -p "$STATE_DIR"
# Log to file without color codes
exec > >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_FILE")) 2>&1

if [ -n "$AT" ]; then schedule_at "$AT"; exit $?; fi
if [ "$ALL" -eq 1 ]; then
  if [ "$ACTION" = "shutdown" ]; then shutdown_all; else rolling_all; fi
  exit $?
fi
if [ -n "$TARGET" ]; then remote_dispatch; fi
case "$ACTION" in
  restore) restore ;;
  *)       drain_and_power ;;
esac
