{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pull main and show status",
      "type": "shell",
      "command": "git pull --ff-only origin main; git status",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    }
  ]
}