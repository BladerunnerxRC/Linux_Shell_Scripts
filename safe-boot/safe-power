#!/bin/bash
# safe-power — Safe reboot / shutdown for the optiplex cluster
#
# Usage (re-runs itself with sudo if not root):
#   safe-power --reboot   [NODE]   drain + reboot, then restore on boot
#   safe-power --shutdown [NODE]   drain + power off (restore at next power-on)
#   safe-power --drain    [NODE]   drain only, no power action
#   safe-power --restore  [NODE]   bring a drained node back (auto on boot)
#   safe-power --status   [NODE]   drained / ok / failed
#   safe-power --check    [NODE]   verify service account, SSH trust, kubectl
#
#   NODE defaults to this host. Any node can target any other node; the work
#   runs on NODE itself over SSH as the safepower service account.
#
#   Options: -y/--yes (no prompt), -n/--dry-run, --no-wait (don't wait for a
#            remote reboot to finish restoring), -h/--help
#
# Role is picked from the hostname:
#   Control plane — kubectl drain self, drain Swarm node, stop Docker
#                   containers; on boot: uncordon, restart, health-check
#   Worker        — kubectl drain self; on boot: wait for Ready, uncordon
#
# One-time setup of the service account on all nodes: safe-power-setup

set -uo pipefail

# ------------------------------------------------------------ CONFIGURATION
# Defaults; /etc/safe-power/cluster.conf (written by safe-power-setup) overrides.
CONTROL_PLANE_HOST="optiplex-docker"
NODES=()
SVC_USER="safepower"
NODE_NAME="$(hostname -s)"
DRAIN_ARGS=(--ignore-daemonsets --delete-emptydir-data)
HEALTH_URLS=(                                 # checked on the control plane only
  "http://localhost:7171"   # comixed
  "http://localhost:3000"   # grafana
  "http://localhost:8080"   # jira
)
BLOCKING_CONTAINERS=("backup-job")            # refuse to run while these run
STOP_TIMEOUT=60           # seconds per container for graceful stop
DRAIN_TIMEOUT=300         # seconds for kubectl drain / swarm tasks to leave
CONVERGE_TIMEOUT=600      # seconds to wait after boot for Ready/services/health
CONF_DIR="/etc/safe-power"
STATE_DIR="/var/lib/safe-power"
LOG_FILE="/var/log/safe-power.log"
UNIT_NAME="safe-power-restore.service"
UNIT_FILE="/etc/systemd/system/${UNIT_NAME}"
SCRIPT_PATH="$(readlink -f "$0")"

# shellcheck source=/dev/null
[ -r "$CONF_DIR/cluster.conf" ] && . "$CONF_DIR/cluster.conf"

SVC_KUBECONFIG="$CONF_DIR/kubeconfig"
SVC_HOME="$(getent passwd "$SVC_USER" | cut -d: -f6)"
if [ "$NODE_NAME" = "$CONTROL_PLANE_HOST" ]; then ROLE="control-plane"; else ROLE="worker"; fi

KUBECTL=()
if command -v kubectl >/dev/null; then KUBECTL=(kubectl)
elif command -v k3s >/dev/null; then KUBECTL=(k3s kubectl); fi

# ------------------------------------------------------------ output
if [ -t 1 ]; then
  RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' BLU=$'\e[34m' CYN=$'\e[36m' BLD=$'\e[1m' RST=$'\e[0m'
else
  RED="" GRN="" YLW="" BLU="" CYN="" BLD="" RST=""
fi
log()  { echo "${BLU}[$(date '+%F %T')]${RST} $*"; }
ok()   { log "${GRN}$*${RST}"; }
warn() { log "${YLW}$*${RST}"; }
err()  { log "${RED}$*${RST}"; }
hdr()  { echo "${CYN}${BLD}== $* ==${RST}"; }
die()  { err "❌ $*"; exit 1; }
run()  { if [ "$DRY_RUN" -eq 1 ]; then log "${YLW}DRY-RUN:${RST} $*"; else "$@"; fi; }
usage() { sed -n '2,26p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# ------------------------------------------------------------ service-account SSH
svc_ready() { [ -n "$SVC_HOME" ] && [ -f "$SVC_HOME/.ssh/id_ed25519" ]; }

# svc_ssh NODE WORD... — every word must be a plain token (checked by the gate)
svc_ssh() {
  local node=$1; shift
  sudo -u "$SVC_USER" ssh -i "$SVC_HOME/.ssh/id_ed25519" \
    -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$SVC_HOME/.ssh/known_hosts" \
    "$SVC_USER@$node" "$*"
}

# Forced command for the service account's authorized_keys. Only allows:
#   true | safe-power <action flags> | kubectl get|drain|cordon|uncordon ...
ssh_gate() {
  local -a w; local t
  read -ra w <<<"${SSH_ORIGINAL_COMMAND:-}"
  reject() { echo "safe-power gate: rejected: ${SSH_ORIGINAL_COMMAND:-<empty>}" >&2; logger -t safe-power "gate rejected: ${SSH_ORIGINAL_COMMAND:-}"; exit 126; }
  for t in "${w[@]}"; do [[ "$t" =~ ^[A-Za-z0-9._=/:,@-]+$ ]] || reject; done
  case "${w[0]:-}" in
    true) exit 0 ;;
    safe-power)
      for t in "${w[@]:1}"; do
        case "$t" in --reboot|--shutdown|--drain|--restore|--status|--check|-y|--yes|-n|--dry-run) ;; *) reject ;; esac
      done
      exec sudo -n "$SCRIPT_PATH" "${w[@]:1}" ;;
    kubectl)
      case "${w[1]:-}" in get|drain|cordon|uncordon) ;; *) reject ;; esac
      [ ${#KUBECTL[@]} -gt 0 ] || { echo "kubectl not installed" >&2; exit 127; }
      KUBECONFIG="$SVC_KUBECONFIG" exec "${KUBECTL[@]}" "${w[@]:1}" ;;
    *) reject ;;
  esac
}

# ------------------------------------------------------------ kubectl access
# 1) local kubectl + kubeconfig (service-account one first), else
# 2) kubectl on the control plane over service-account SSH.
KUBE_MODE=""
KUBE_LOCAL_CFG=""
kube_detect() {
  KUBE_MODE=""
  if [ ${#KUBECTL[@]} -gt 0 ]; then
    local cfg
    for cfg in "$SVC_KUBECONFIG" "${KUBECONFIG:-}" /etc/kubernetes/admin.conf \
               /etc/rancher/k3s/k3s.yaml /root/.kube/config; do
      [ -n "$cfg" ] && [ -r "$cfg" ] || continue
      if KUBECONFIG="$cfg" "${KUBECTL[@]}" get node "$NODE_NAME" --request-timeout=5s >/dev/null 2>&1; then
        KUBE_MODE="local"; KUBE_LOCAL_CFG="$cfg"; return 0
      fi
    done
  fi
  if [ "$ROLE" = "worker" ] && svc_ready && \
     svc_ssh "$CONTROL_PLANE_HOST" kubectl get node "$NODE_NAME" --request-timeout=5s >/dev/null 2>&1; then
    KUBE_MODE="ssh"; return 0
  fi
  return 1
}

# kube SUBCOMMAND ARGS... (subcommand first — the SSH gate checks it)
kube() {
  case "$KUBE_MODE" in
    local) KUBECONFIG="$KUBE_LOCAL_CFG" "${KUBECTL[@]}" "$@" ;;
    ssh)   svc_ssh "$CONTROL_PLANE_HOST" kubectl "$@" ;;
    *)     return 1 ;;
  esac
}

node_ready() {
  kube get node "$NODE_NAME" --no-headers --request-timeout=5s 2>/dev/null \
    | awk '{print $2}' | grep -Eq '^Ready(,|$)'
}

# ------------------------------------------------------------ Docker helpers
have_docker()      { command -v docker >/dev/null && docker info >/dev/null 2>&1; }
swarm_active()     { [ "$(docker info -f '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; }
swarm_task_count() { docker ps -q --filter label=com.docker.swarm.service.id | wc -l; }

# ============================================================ PHASE 1 + 2
drain_and_power() {
  hdr "safe-power --$ACTION on $NODE_NAME ($ROLE)"

  # Preflight
  if pgrep -x "apt|apt-get|dpkg|unattended-upgr" >/dev/null; then
    die "apt/dpkg is running. Try again when it finishes."
  fi
  local docker_ok=0 standalone=""
  if have_docker; then
    docker_ok=1
    for c in "${BLOCKING_CONTAINERS[@]}"; do
      docker ps --format '{{.Names}}' | grep -q -- "$c" && die "'$c' is running. Try again when it finishes."
    done
    standalone=$(docker ps --format '{{.Names}}\t{{.Label "com.docker.swarm.service.id"}}' \
                 | awk -F'\t' '$2=="" {print $1}')
  fi

  if kube_detect; then
    log "☸️  kubectl via $KUBE_MODE${KUBE_LOCAL_CFG:+ ($KUBE_LOCAL_CFG)}"
  elif [ "$ROLE" = "worker" ]; then
    die "No kubectl access (local or via $SVC_USER@$CONTROL_PLANE_HOST). Run safe-power-setup. Refusing to power off an undrained worker."
  else
    warn "⚠️  kubectl not available; skipping Kubernetes drain."
  fi

  # Summary + confirm
  [ -n "$KUBE_MODE" ] && log "📋 Pods on $NODE_NAME: $(kube get pods -A --field-selector "spec.nodeName=$NODE_NAME" --no-headers 2>/dev/null | wc -l)"
  [ "$docker_ok" -eq 1 ] && log "📋 Standalone containers: $(grep -c . <<<"$standalone")"
  [ "$ROLE" = "control-plane" ] && [ "$ACTION" = "shutdown" ] && \
    warn "⚠️  Shutting down the control plane: workers keep running but the cluster can't be managed until it's back."

  if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    read -r -p "Proceed with ${ACTION^^} of $NODE_NAME? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
  fi

  if [ "$DRY_RUN" -ne 1 ]; then
    echo "$standalone" > "$STATE_DIR/containers.txt"
    date '+%F %T'      > "$STATE_DIR/drained_at"
  fi

  # 1a. Kubernetes drain
  if [ -n "$KUBE_MODE" ]; then
    log "🚰 kubectl drain $NODE_NAME ${DRAIN_ARGS[*]}"
    if ! run kube drain "$NODE_NAME" "${DRAIN_ARGS[@]}" "--timeout=${DRAIN_TIMEOUT}s"; then
      warn "↩️  Drain failed; uncordoning $NODE_NAME"
      kube uncordon "$NODE_NAME" >/dev/null
      rm -f "$STATE_DIR/drained_at"
      die "kubectl drain failed (PodDisruptionBudget? stuck pod?). Nothing was powered off."
    fi
  fi

  # 1b. Docker Swarm drain
  if [ "$docker_ok" -eq 1 ] && swarm_active; then
    local nid; nid=$(docker info -f '{{.Swarm.NodeID}}')
    [ "$DRY_RUN" -ne 1 ] && echo "$nid" > "$STATE_DIR/swarm_node_id"
    log "🚰 Draining swarm node $nid"
    run docker node update --availability drain "$nid" >/dev/null || warn "⚠️  Swarm drain failed; continuing."
    if [ "$DRY_RUN" -ne 1 ]; then
      local waited=0
      while [ "$(swarm_task_count)" -gt 0 ] && [ "$waited" -lt "$DRAIN_TIMEOUT" ]; do
        sleep 5; waited=$((waited + 5))
      done
    fi
  fi

  # 1c. Standalone containers (reverse start order)
  if [ -n "$standalone" ]; then
    log "🛑 Stopping standalone containers (timeout ${STOP_TIMEOUT}s each)"
    # shellcheck disable=SC2086
    run docker stop -t "$STOP_TIMEOUT" $(tac <<<"$standalone") >/dev/null
  fi

  # Arm the restore unit
  log "🔧 Enabling $UNIT_NAME for restore on next boot"
  if [ "$DRY_RUN" -ne 1 ]; then
    cat > "$UNIT_FILE" <<EOF
[Unit]
Description=safe-power restore after drain
After=network-online.target remote-fs.target docker.service kubelet.service k3s.service k3s-agent.service
Wants=network-online.target
ConditionPathExists=${STATE_DIR}/drained_at

[Service]
Type=oneshot
ExecStart=${SCRIPT_PATH} --restore
TimeoutStartSec=$((CONVERGE_TIMEOUT * 2 + 120))

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable "$UNIT_NAME" >/dev/null 2>&1
  fi

  # 2. Power action
  case "$ACTION" in
    drain)    ok "✅ Drained. Run 'safe-power --restore' to bring $NODE_NAME back." ;;
    reboot)   log "💾 sync"; run sync; ok "🔁 Rebooting $NODE_NAME";    run systemctl reboot ;;
    shutdown) log "💾 sync"; run sync; ok "⏻  Powering off $NODE_NAME"; run systemctl poweroff ;;
  esac
}

# ============================================================ PHASE 3
restore() {
  hdr "safe-power --restore on $NODE_NAME ($ROLE)"
  local failures=0 deadline

  # Docker side
  if command -v docker >/dev/null; then
    deadline=$((SECONDS + 120))
    until have_docker || [ "$SECONDS" -ge "$deadline" ]; do sleep 5; done
    if have_docker; then
      if swarm_active; then
        local nid; nid=$(cat "$STATE_DIR/swarm_node_id" 2>/dev/null || docker info -f '{{.Swarm.NodeID}}')
        log "🔌 Swarm node $nid → active"
        docker node update --availability active "$nid" >/dev/null || { err "❌ Swarm activate failed"; failures=$((failures + 1)); }
      fi
      if [ -s "$STATE_DIR/containers.txt" ]; then
        while read -r c; do
          [ -z "$c" ] && continue
          if [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" != "true" ]; then
            log "▶️  Starting $c"
            docker start "$c" >/dev/null || { err "❌ Failed to start $c"; failures=$((failures + 1)); }
          fi
        done < "$STATE_DIR/containers.txt"
      fi
    else
      err "❌ Docker didn't come up"; failures=$((failures + 1))
    fi
  fi

  # Kubernetes: wait for Ready, then uncordon
  deadline=$((SECONDS + CONVERGE_TIMEOUT))
  until kube_detect || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
  if [ -n "$KUBE_MODE" ]; then
    log "⏳ Waiting for $NODE_NAME to be Ready"
    until node_ready || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
    if node_ready; then
      ok "✅ $NODE_NAME is Ready — uncordoning"
      kube uncordon "$NODE_NAME" >/dev/null || { err "❌ uncordon failed"; failures=$((failures + 1)); }
    else
      err "❌ $NODE_NAME not Ready after ${CONVERGE_TIMEOUT}s — left cordoned"; failures=$((failures + 1))
    fi
  elif [ ${#KUBECTL[@]} -gt 0 ] || [ "$ROLE" = "worker" ]; then
    err "❌ kubectl unreachable. On $CONTROL_PLANE_HOST run: kubectl uncordon $NODE_NAME"
    failures=$((failures + 1))
  fi

  # Swarm services converge (N/N; ignore completed jobs)
  if have_docker && swarm_active; then
    deadline=$((SECONDS + CONVERGE_TIMEOUT))
    local pending
    while :; do
      pending=$(docker service ls --format '{{.Name}} {{.Replicas}}' | grep -v completed \
                | awk '{split($2,r,"/"); if (r[1]!=r[2]) print $1" ("$2")"}')
      [ -z "$pending" ] && { ok "✅ Swarm services converged"; break; }
      if [ "$SECONDS" -ge "$deadline" ]; then
        err "❌ Swarm services not converged:"; sed 's/^/     - /' <<<"$pending"
        failures=$((failures + 1)); break
      fi
      sleep 10
    done
  fi

  # Health checks (control plane only)
  if [ "$ROLE" = "control-plane" ]; then
    local url code
    for url in "${HEALTH_URLS[@]}"; do
      deadline=$((SECONDS + CONVERGE_TIMEOUT))
      while :; do
        code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$url")
        if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then ok "✅ $url → HTTP $code"; break; fi
        if [ "$SECONDS" -ge "$deadline" ]; then
          err "❌ $url unhealthy (HTTP $code)"; failures=$((failures + 1)); break
        fi
        sleep 10
      done
    done
  fi

  # Disarm + record result (read by --status)
  systemctl disable "$UNIT_NAME" >/dev/null 2>&1
  rm -f "$UNIT_FILE" "$STATE_DIR/drained_at"
  systemctl daemon-reload

  if [ "$failures" -gt 0 ]; then
    echo "failed $failures problem(s) $(date '+%F %T')" > "$STATE_DIR/last_result"
    warn "⚠️  Restore finished with $failures problem(s). See $LOG_FILE"
    exit 1
  fi
  echo "ok restored $(date '+%F %T')" > "$STATE_DIR/last_result"
  ok "🎉 Restore complete — $NODE_NAME is healthy."
}

# ============================================================ status / check
status() {
  if [ -f "$STATE_DIR/drained_at" ]; then echo "drained since $(cat "$STATE_DIR/drained_at")"
  elif [ -s "$STATE_DIR/last_result" ]; then cat "$STATE_DIR/last_result"
  else echo "ok"; fi
}

check() {
  local f=0 n
  chk() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then echo "  ${GRN}✔${RST} $label"; else echo "  ${RED}✘${RST} $label"; f=$((f + 1)); fi
  }
  hdr "safe-power check — $NODE_NAME ($ROLE)"
  chk "cluster.conf (control plane: $CONTROL_PLANE_HOST, nodes: ${NODES[*]:-none})" test -r "$CONF_DIR/cluster.conf"
  chk "service account '$SVC_USER'"          id "$SVC_USER"
  chk "passphrase-less SSH key"              svc_ready
  chk "sudoers rule (/etc/sudoers.d/safe-power)" test -f /etc/sudoers.d/safe-power
  if kube_detect; then
    echo "  ${GRN}✔${RST} kubectl via $KUBE_MODE${KUBE_LOCAL_CFG:+ ($KUBE_LOCAL_CFG)}"
  else
    echo "  ${RED}✘${RST} kubectl access"; f=$((f + 1))
  fi
  for n in "${NODES[@]}"; do
    [ "$n" = "$NODE_NAME" ] && continue
    chk "ssh $SVC_USER → $n" svc_ssh "$n" true
  done
  [ "$f" -eq 0 ] && echo "  ${GRN}${BLD}all checks passed${RST}" || echo "  ${RED}${BLD}$f check(s) failed${RST}"
  return "$f"
}

# ============================================================ remote target
wait_for_restore() {
  local n=$1 st deadline=$((SECONDS + CONVERGE_TIMEOUT * 2 + 600))
  log "⏳ Waiting for $n to reboot and restore (Ctrl+C stops waiting; restore still runs on $n)"
  sleep 20
  while [ "$SECONDS" -lt "$deadline" ]; do
    st=$(svc_ssh "$n" safe-power --status 2>/dev/null) || st="unreachable"
    case "$st" in
      ok*)     ok "✅ $n is back: $st"; return 0 ;;
      failed*) err "❌ $n restore: $st (see $LOG_FILE on $n)"; return 1 ;;
    esac
    sleep 15
  done
  err "❌ Timed out waiting for $n. Check: safe-power --status $n"; return 1
}

remote_dispatch() {
  local n=$TARGET rc args=("--$ACTION")
  if [ ${#NODES[@]} -gt 0 ] && [[ " ${NODES[*]} " != *" $n "* ]]; then
    die "'$n' is not in NODES (${NODES[*]}). Add it with safe-power-setup."
  fi
  svc_ready || die "No $SVC_USER SSH key on $NODE_NAME. Run safe-power-setup."
  svc_ssh "$n" true 2>/dev/null || die "Can't reach $SVC_USER@$n over SSH. Try: safe-power --check"

  case "$ACTION" in
    reboot|shutdown|drain|restore)
      if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
        read -r -p "Proceed with ${ACTION^^} of ${n} (from $NODE_NAME)? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
      fi
      args+=(-y) ;;
  esac
  [ "$DRY_RUN" -eq 1 ] && args+=(--dry-run)

  log "📡 $NODE_NAME → $n: safe-power ${args[*]}"
  svc_ssh "$n" safe-power "${args[@]}"; rc=$?

  case "$ACTION" in
    reboot)
      # 255 = connection dropped by the reboot
      [ "$rc" -ne 0 ] && [ "$rc" -ne 255 ] && die "safe-power on $n failed (rc=$rc)."
      [ "$DRY_RUN" -eq 1 ] || [ "$NO_WAIT" -eq 1 ] && exit 0
      wait_for_restore "$n"; exit $? ;;
    shutdown)
      [ "$rc" -ne 0 ] && [ "$rc" -ne 255 ] && die "safe-power on $n failed (rc=$rc)."
      ok "⏻  $n is powering off. Restore runs automatically at next power-on."; exit 0 ;;
    *) exit "$rc" ;;
  esac
}

# ============================================================ main
[ "${1:-}" = "--ssh-gate" ] && ssh_gate

ACTION=""; TARGET=""; ASSUME_YES=0; DRY_RUN=0; NO_WAIT=0
for arg in "$@"; do
  case "$arg" in
    --reboot|--shutdown|--drain|--restore|--status|--check) ACTION="${arg#--}" ;;
    -y|--yes)     ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    --no-wait)    NO_WAIT=1 ;;
    -h|--help)    usage 0 ;;
    -*) echo "Unknown option: $arg" >&2; usage 2 ;;
    *)  [ -z "$TARGET" ] || { echo "Only one NODE allowed" >&2; usage 2; }; TARGET="$arg" ;;
  esac
done
[ -n "$ACTION" ] || { echo "Choose an action: --reboot --shutdown --drain --restore --status --check" >&2; usage 2; }
[ "$TARGET" = "$NODE_NAME" ] || [ "$TARGET" = "localhost" ] && TARGET=""

# Require root: re-exec through sudo (prompts for password if needed)
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null || { echo "❌ Must run as root and sudo is not installed." >&2; exit 1; }
  exec sudo -- "$SCRIPT_PATH" "$@"
fi

if [ -z "$TARGET" ]; then
  case "$ACTION" in
    status) status; exit 0 ;;
    check)  check;  exit $? ;;
  esac
fi

mkdir -p "$STATE_DIR"
# Log to file without color codes
exec > >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_FILE")) 2>&1

if [ -n "$TARGET" ]; then remote_dispatch; fi
case "$ACTION" in
  restore) restore ;;
  *)       drain_and_power ;;
esac
