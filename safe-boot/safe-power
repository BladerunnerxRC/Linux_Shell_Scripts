#!/bin/bash
# safe-power — Safe reboot / shutdown for the optiplex cluster
#
# Detects its role from the hostname:
#
#   Control plane (optiplex-docker)
#     1. DRAIN   — kubectl drain self, drain Swarm node (if active),
#                  gracefully stop standalone Docker containers
#     2. POWER   — sync, then reboot or power off
#     3. RESTORE — on next boot: wait for node Ready, uncordon, restart
#                  containers, wait for services, health-check URLs
#
#   Worker (optiplex-three, ...)
#     1. DRAIN   — kubectl drain <this node> (locally, or over SSH on the
#                  control plane), stop any standalone Docker containers
#     2. POWER   — sync, then reboot or power off
#     3. RESTORE — on next boot: wait for node Ready, kubectl uncordon
#
# Usage (re-runs itself with sudo if not root):
#   safe-power --reboot        # drain + reboot (asks for confirmation)
#   safe-power --shutdown      # drain + power off (restore runs at next power-on)
#   safe-power --drain         # drain only, no power action
#   safe-power --restore       # bring everything back (runs automatically on boot)
#   Options: -y/--yes (no prompt), -n/--dry-run, -h/--help

set -uo pipefail

# ------------------------------------------------------------ CONFIGURATION
CONTROL_PLANE_HOST="optiplex-docker"          # hostname -s of the control plane
CONTROL_PLANE_SSH="optiplex-docker"           # ssh target used by workers for kubectl
NODE_NAME="$(hostname -s)"                    # Kubernetes node name of this host
DRAIN_ARGS=(--ignore-daemonsets --delete-emptydir-data)
HEALTH_URLS=(                                 # checked on the control plane only
  "http://localhost:7171"   # comixed
  "http://localhost:3000"   # grafana
  "http://localhost:8080"   # jira
)
BLOCKING_CONTAINERS=("backup-job")            # refuse to run while these run
STOP_TIMEOUT=60           # seconds per container for graceful stop
DRAIN_TIMEOUT=300         # seconds for kubectl drain / swarm tasks to leave
CONVERGE_TIMEOUT=600      # seconds to wait after boot for Ready/services/health
STATE_DIR="/var/lib/safe-power"
LOG_FILE="/var/log/safe-power.log"
UNIT_NAME="safe-power-restore.service"
UNIT_FILE="/etc/systemd/system/${UNIT_NAME}"
SCRIPT_PATH="$(readlink -f "$0")"

usage() { sed -n '2,25p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

ACTION=""
ASSUME_YES=0
DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --reboot)     ACTION="reboot" ;;
    --shutdown)   ACTION="shutdown" ;;
    --drain)      ACTION="drain" ;;
    --restore)    ACTION="restore" ;;
    -y|--yes)     ASSUME_YES=1 ;;
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help)    usage 0 ;;
    *) echo "Unknown argument: $arg" >&2; usage 2 ;;
  esac
done
[ -n "$ACTION" ] || { echo "Choose one of --reboot, --shutdown, --drain, --restore" >&2; usage 2; }

# Require root: re-exec through sudo (prompts for password if needed)
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null || { echo "❌ Must run as root and sudo is not installed." >&2; exit 1; }
  exec sudo -- "$SCRIPT_PATH" "$@"
fi

mkdir -p "$STATE_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1

log() { echo "[$(date '+%F %T')] $*"; }
run() { if [ "$DRY_RUN" -eq 1 ]; then log "DRY-RUN: $*"; else "$@"; fi; }
die() { log "❌ $*"; exit 1; }

if [ "$NODE_NAME" = "$CONTROL_PLANE_HOST" ]; then ROLE="control-plane"; else ROLE="worker"; fi

# ------------------------------------------------------------ kubectl access
# Prefer a local kubeconfig; otherwise run kubectl on the control plane over
# SSH as the invoking user (needs key-based auth for the unattended restore).
KUBE_MODE=""
KUBE_LOCAL_CFG=""
SSH_USER="${SUDO_USER:-$(cat "$STATE_DIR/ssh_user" 2>/dev/null || echo root)}"

kube_detect() {
  command -v kubectl >/dev/null || [ "$ROLE" = "worker" ] || return 1
  if command -v kubectl >/dev/null; then
    local cfg
    for cfg in "${KUBECONFIG:-}" /etc/kubernetes/admin.conf /etc/rancher/k3s/k3s.yaml \
               /root/.kube/config "$(getent passwd "$SSH_USER" | cut -d: -f6)/.kube/config"; do
      [ -n "$cfg" ] && [ -r "$cfg" ] || continue
      if KUBECONFIG="$cfg" kubectl --request-timeout=5s get node "$NODE_NAME" >/dev/null 2>&1; then
        KUBE_MODE="local"; KUBE_LOCAL_CFG="$cfg"; return 0
      fi
    done
  fi
  if [ "$ROLE" = "worker" ] && \
     sudo -u "$SSH_USER" ssh -o BatchMode=yes -o ConnectTimeout=10 "$CONTROL_PLANE_SSH" \
       kubectl --request-timeout=5s get node "$NODE_NAME" >/dev/null 2>&1; then
    KUBE_MODE="ssh"; return 0
  fi
  return 1
}

kube() {
  case "$KUBE_MODE" in
    local) KUBECONFIG="$KUBE_LOCAL_CFG" kubectl "$@" ;;
    ssh)   sudo -u "$SSH_USER" ssh -o BatchMode=yes -o ConnectTimeout=10 \
             "$CONTROL_PLANE_SSH" "kubectl $(printf '%q ' "$@")" ;;
    *)     return 1 ;;
  esac
}

node_ready() {
  [ "$(kube --request-timeout=5s get node "$NODE_NAME" \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]
}

# ------------------------------------------------------------ Docker helpers
have_docker()      { command -v docker >/dev/null && docker info >/dev/null 2>&1; }
swarm_active()     { [ "$(docker info -f '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = "active" ]; }
swarm_task_count() { docker ps -q --filter label=com.docker.swarm.service.id | wc -l; }

# ============================================================ PHASE 1 + 2
drain_and_power() {
  log "🕒 safe-power --$ACTION on $NODE_NAME ($ROLE)"

  # Preflight
  if pgrep -x "apt|apt-get|dpkg|unattended-upgr" >/dev/null; then
    die "apt/dpkg is running. Try again when it finishes."
  fi
  local docker_ok=0 standalone=""
  if have_docker; then
    docker_ok=1
    for c in "${BLOCKING_CONTAINERS[@]}"; do
      docker ps --format '{{.Names}}' | grep -q -- "$c" && die "'$c' is running. Try again when it finishes."
    done
    standalone=$(docker ps --format '{{.Names}}\t{{.Label "com.docker.swarm.service.id"}}' \
                 | awk -F'\t' '$2=="" {print $1}')
  fi

  if kube_detect; then
    log "☸️  kubectl via $KUBE_MODE${KUBE_LOCAL_CFG:+ ($KUBE_LOCAL_CFG)}"
  elif [ "$ROLE" = "worker" ]; then
    die "Can't reach kubectl locally or via 'ssh $CONTROL_PLANE_SSH' as $SSH_USER. Refusing to reboot an undrained worker."
  else
    log "⚠️  kubectl not available; skipping Kubernetes drain."
  fi

  # Summary + confirm
  [ -n "$KUBE_MODE" ] && log "📋 Pods on $NODE_NAME: $(kube get pods -A --field-selector spec.nodeName="$NODE_NAME" --no-headers 2>/dev/null | wc -l)"
  [ "$docker_ok" -eq 1 ] && log "📋 Standalone containers: $(grep -c . <<<"$standalone")"
  [ "$ROLE" = "control-plane" ] && [ "$ACTION" = "shutdown" ] && \
    log "⚠️  Shutting down the control plane: workers keep running but the cluster can't be managed until it's back."

  if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    read -r -p "Proceed with ${ACTION^^} of $NODE_NAME? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
  fi

  if [ "$DRY_RUN" -ne 1 ]; then
    echo "$standalone" > "$STATE_DIR/containers.txt"
    echo "$SSH_USER"   > "$STATE_DIR/ssh_user"
    date '+%F %T'      > "$STATE_DIR/drained_at"
  fi

  # 1a. Kubernetes drain
  if [ -n "$KUBE_MODE" ]; then
    log "🚰 kubectl drain $NODE_NAME ${DRAIN_ARGS[*]}"
    if ! run kube drain "$NODE_NAME" "${DRAIN_ARGS[@]}" --timeout="${DRAIN_TIMEOUT}s"; then
      log "↩️  Drain failed; uncordoning $NODE_NAME"
      kube uncordon "$NODE_NAME" >/dev/null
      rm -f "$STATE_DIR/drained_at"
      die "kubectl drain failed (PodDisruptionBudget? stuck pod?). Nothing was rebooted."
    fi
  fi

  # 1b. Docker Swarm drain
  if [ "$docker_ok" -eq 1 ] && swarm_active; then
    local nid; nid=$(docker info -f '{{.Swarm.NodeID}}')
    [ "$DRY_RUN" -ne 1 ] && echo "$nid" > "$STATE_DIR/swarm_node_id"
    log "🚰 Draining swarm node $nid"
    run docker node update --availability drain "$nid" >/dev/null || log "⚠️  Swarm drain failed; continuing."
    if [ "$DRY_RUN" -ne 1 ]; then
      local waited=0
      while [ "$(swarm_task_count)" -gt 0 ] && [ "$waited" -lt "$DRAIN_TIMEOUT" ]; do
        sleep 5; waited=$((waited + 5))
      done
    fi
  fi

  # 1c. Standalone containers (reverse start order)
  if [ -n "$standalone" ]; then
    log "🛑 Stopping standalone containers (timeout ${STOP_TIMEOUT}s each)"
    # shellcheck disable=SC2086
    run docker stop -t "$STOP_TIMEOUT" $(tac <<<"$standalone") >/dev/null
  fi

  # Arm the restore unit
  log "🔧 Enabling $UNIT_NAME for restore on next boot"
  if [ "$DRY_RUN" -ne 1 ]; then
    cat > "$UNIT_FILE" <<EOF
[Unit]
Description=safe-power restore after drain
After=network-online.target remote-fs.target docker.service kubelet.service k3s.service k3s-agent.service
Wants=network-online.target
ConditionPathExists=${STATE_DIR}/drained_at

[Service]
Type=oneshot
ExecStart=${SCRIPT_PATH} --restore
TimeoutStartSec=$((CONVERGE_TIMEOUT * 2 + 120))

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable "$UNIT_NAME" >/dev/null 2>&1
  fi

  # 2. Power action
  case "$ACTION" in
    drain)    log "✅ Drained. Run 'safe-power --restore' to bring $NODE_NAME back." ;;
    reboot)   log "💾 sync"; run sync; log "🔁 Rebooting";     run systemctl reboot ;;
    shutdown) log "💾 sync"; run sync; log "⏻  Powering off";  run systemctl poweroff ;;
  esac
}

# ============================================================ PHASE 3
restore() {
  log "🕒 safe-power --restore on $NODE_NAME ($ROLE)"
  local failures=0 deadline

  # Docker side (containers first so services the node depends on come up)
  if command -v docker >/dev/null; then
    deadline=$((SECONDS + 120))
    until have_docker || [ "$SECONDS" -ge "$deadline" ]; do sleep 5; done
    if have_docker; then
      if swarm_active; then
        local nid; nid=$(cat "$STATE_DIR/swarm_node_id" 2>/dev/null || docker info -f '{{.Swarm.NodeID}}')
        log "🔌 Swarm node $nid → active"
        docker node update --availability active "$nid" >/dev/null || { log "❌ Swarm activate failed"; failures=$((failures + 1)); }
      fi
      if [ -s "$STATE_DIR/containers.txt" ]; then
        while read -r c; do
          [ -z "$c" ] && continue
          if [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" != "true" ]; then
            log "▶️  Starting $c"
            docker start "$c" >/dev/null || { log "❌ Failed to start $c"; failures=$((failures + 1)); }
          fi
        done < "$STATE_DIR/containers.txt"
      fi
    else
      log "❌ Docker didn't come up"; failures=$((failures + 1))
    fi
  fi

  # Kubernetes: wait for Ready, then uncordon
  deadline=$((SECONDS + CONVERGE_TIMEOUT))
  until kube_detect || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
  if [ -n "$KUBE_MODE" ]; then
    log "⏳ Waiting for $NODE_NAME to be Ready"
    until node_ready || [ "$SECONDS" -ge "$deadline" ]; do sleep 10; done
    if node_ready; then
      log "✅ $NODE_NAME is Ready — uncordoning"
      kube uncordon "$NODE_NAME" >/dev/null || { log "❌ uncordon failed"; failures=$((failures + 1)); }
    else
      log "❌ $NODE_NAME not Ready after ${CONVERGE_TIMEOUT}s — left cordoned"; failures=$((failures + 1))
    fi
  else
    log "❌ kubectl unreachable. On $CONTROL_PLANE_SSH run: kubectl uncordon $NODE_NAME"
    failures=$((failures + 1))
  fi

  # Swarm services converge (N/N; ignore completed jobs)
  if have_docker && swarm_active; then
    deadline=$((SECONDS + CONVERGE_TIMEOUT))
    local pending
    while :; do
      pending=$(docker service ls --format '{{.Name}} {{.Replicas}}' | grep -v completed \
                | awk '{split($2,r,"/"); if (r[1]!=r[2]) print $1" ("$2")"}')
      [ -z "$pending" ] && { log "✅ Swarm services converged"; break; }
      if [ "$SECONDS" -ge "$deadline" ]; then
        log "❌ Swarm services not converged:"; sed 's/^/     - /' <<<"$pending"
        failures=$((failures + 1)); break
      fi
      sleep 10
    done
  fi

  # Health checks (control plane only)
  if [ "$ROLE" = "control-plane" ]; then
    local url code
    for url in "${HEALTH_URLS[@]}"; do
      deadline=$((SECONDS + CONVERGE_TIMEOUT))
      while :; do
        code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$url")
        if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then log "✅ $url → HTTP $code"; break; fi
        if [ "$SECONDS" -ge "$deadline" ]; then
          log "❌ $url unhealthy (HTTP $code)"; failures=$((failures + 1)); break
        fi
        sleep 10
      done
    done
  fi

  # Disarm
  systemctl disable "$UNIT_NAME" >/dev/null 2>&1
  rm -f "$UNIT_FILE" "$STATE_DIR/drained_at"
  systemctl daemon-reload

  if [ "$failures" -gt 0 ]; then
    log "⚠️  Restore finished with $failures problem(s). See $LOG_FILE"
    exit 1
  fi
  log "🎉 Restore complete — $NODE_NAME is healthy."
}

if [ "$ACTION" = "restore" ]; then restore; else drain_and_power; fi
