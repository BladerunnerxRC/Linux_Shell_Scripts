#!/usr/bin/env bash
#
# =====================================================================
#  safe-power
#  ---------------------------------------------------------------------
#  A system-grade shutdown/reboot wrapper that ensures Docker workloads
#  are stopped cleanly before the host powers off. The script integrates
#  with systemd inhibitor locks to prevent race conditions between
#  container shutdown and system shutdown.
#
#  Author: T.A.Smith
#  Version: 1.1
# =====================================================================

VERSION="1.1"

# ---------------------------------------------------------
# systemd Inhibitor Wrapper (one-time, guarded)
# ---------------------------------------------------------
if [[ -z "${SAFE_POWER_INHIBITED:-}" ]]; then
    export SAFE_POWER_INHIBITED=1
    exec systemd-inhibit \
      --what=shutdown \
      --who="safe-power" \
      --why="Gracefully stopping Docker containers" \
      --mode=block \
      "$0" "$@"
fi

set -euo pipefail

# ---------------------------------------------------------
# Defaults
# ---------------------------------------------------------
DRYRUN=false
FORCE=false
NOCONFIRM=false
VERBOSE=false
ACTION=""
TIMEOUT=20
USE_COLOR=true

# ---------------------------------------------------------
# ANSI colors (optional)
# ---------------------------------------------------------
YELLOW="\e[33m"
RESET="\e[0m"

disable_colors() {
    YELLOW=""
    RESET=""
}

# ---------------------------------------------------------
# Verbose output helper (safe with set -e)
# ---------------------------------------------------------
vprint() {
    if $VERBOSE; then
        echo -e "$@"
    fi
}

# ---------------------------------------------------------
# Usage
# ---------------------------------------------------------
usage() {
    cat <<EOF
Usage: safe-power [reboot|shutdown] [options]

Options:
  --dryrun        Show actions without executing
  --force         Skip Docker entirely
  --timeout=N     Docker stop timeout (default: 20)
  --no-color      Disable ANSI colors
  --noconfirm     Skip confirmation prompt
  --verbose       Enable human-readable output
  --version       Show version and exit
EOF
    exit 1
}

# ---------------------------------------------------------
# Argument Parsing
# ---------------------------------------------------------
for arg in "$@"; do
    case "$arg" in
        reboot|shutdown)
            ACTION="$arg"
            ;;
        --dryrun)
            DRYRUN=true
            ;;
        --force)
            FORCE=true
            ;;
        --noconfirm)
            NOCONFIRM=true
            ;;
        --verbose)
            VERBOSE=true
            ;;
        --no-color)
            USE_COLOR=false
            ;;
        --timeout=*)
            TIMEOUT="${arg#*=}"
            [[ "$TIMEOUT" =~ ^[0-9]+$ ]] || usage
            ;;
        --version)
            echo "safe-power version $VERSION"
            exit 0
            ;;
        *)
            usage
            ;;
    esac
done

[ "$USE_COLOR" = false ] && disable_colors
[ -z "$ACTION" ] && usage

# ---------------------------------------------------------
# Confirmation
# ---------------------------------------------------------
confirm_action() {
    $NOCONFIRM || $DRYRUN && return 0
    echo -ne "${YELLOW}Proceed with $ACTION? [Y/n]: ${RESET}"
    read -r reply
    [[ -z "$reply" || "$reply" =~ ^[Yy] ]] || exit 1
}

# ---------------------------------------------------------
# Main Logic
# ---------------------------------------------------------
main() {
    logger -t safe-power \
        "Invoked: version=$VERSION action=$ACTION dryrun=$DRYRUN force=$FORCE timeout=$TIMEOUT"

    vprint "safe-power $VERSION"
    vprint "Action: $ACTION"
    $DRYRUN && vprint "Dry-run mode enabled"

    confirm_action

    if $FORCE; then
        logger -t safe-power "[FORCE] Skipping Docker container stop"
        vprint "Force mode: skipping Docker cleanup"
        $DRYRUN && return 0
        [[ "$ACTION" == reboot ]] && systemctl reboot -i || systemctl poweroff -i
    fi

    if systemctl is-active --quiet docker && command -v docker >/dev/null; then
        containers=$(docker ps -q)

        if [[ -n "$containers" ]]; then
            if $DRYRUN; then
                logger -t safe-power "[DRYRUN] Would stop containers: $containers"
                vprint "Would stop Docker containers:"
                if $VERBOSE; then
                    docker ps --format '  {{.Names}} ({{.ID}})'
                    echo
                    vprint "Containers that would NOT be stopped:"
                    docker ps --filter status=running \
                              --format '  {{.Names}} ({{.ID}})' \
                    | grep -v -F -f <(docker ps -q) || true
                fi
            else
                logger -t safe-power "Stopping containers (timeout=$TIMEOUT)"
                vprint "Stopping Docker containers (timeout=$TIMEOUT)"
                docker stop --time="$TIMEOUT" $containers >/dev/null || true
            fi
        else
            logger -t safe-power "No running containers"
            vprint "No running Docker containers"
        fi
    else
        logger -t safe-power "Docker not active or not installed"
        vprint "Docker not active or not installed"
    fi

    $DRYRUN && return 0
    vprint "Proceeding with $ACTION"
    [[ "$ACTION" == reboot ]] && systemctl reboot -i || systemctl poweroff -i
}

# ---------------------------------------------------------
# Invoke
# ---------------------------------------------------------
main "$@"
